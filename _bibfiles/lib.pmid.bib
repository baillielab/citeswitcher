 issn = {1471-0072},
 journal = {Nature Reviews Molecular Cell Biology},
 langid = {english},
 month = {January},
 number = {6},
 pages = {362--375},
 shorttitle = {{{ARF}} Family {{G}} Proteins and Their Regulators},
 title = {{{ARF}} Family {{G}} Proteins and Their Regulators: Roles in Membrane Transport, Development and Disease},
 urldate = {2012-07-24},
 volume = {12},
 year = {2011}
}

