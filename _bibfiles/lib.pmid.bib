@article{brownnonlinearimputationpao22016,
 abstract = {{$<$}h3{$>$}Background{$<$}/h3{$><$}p{$>$}ARDS is an important clinical problem. The definition of ARDS requires testing of arterial blood gas to define the ratio of Pao\textsubscript{2} to Fio\textsubscript{2} (Pao\textsubscript{2}/Fio\textsubscript{2} ratio). However, many patients with ARDS do not undergo blood gas measurement, which may result in underdiagnosis of the condition. As a consequence, a method for estimating Pao\textsubscript{2} on the basis of noninvasive measurements is desirable.{$<$}/p{$><$}h3{$>$}Methods{$<$}/h3{$><$}p{$>$}Using data from three ARDS Network studies, we analyzed the enrollment arterial blood gas measurements to compare nonlinear with linear and log-linear imputation methods of estimating Pao\textsubscript{2} from percent saturation of hemoglobin with oxygen as measured by pulse oximetry (Spo\textsubscript{2}). We compared mortality on the basis of various measured and imputed Pao\textsubscript{2}/Fio\textsubscript{2} ratio cutoffs to ensure clinical equivalence.{$<$}/p{$><$}h3{$>$}Results{$<$}/h3{$><$}p{$>$}We studied 1,184 patients, in 707 of whom the Spo\textsubscript{2} {$\leq$} 96\%. Nonlinear imputation from the Spo\textsubscript{2}/Fio\textsubscript{2} ratio resulted in lower error than linear or log-linear imputation (\emph{P} {$<$} .001) for patients with Spo\textsubscript{2} {$\leq$} 96\% but was equivalent to log-linear imputation in all patients. Ninety-day hospital mortality was 26\% to 30\%, depending on the Pao\textsubscript{2}/Fio\textsubscript{2} ratio, whether nonlinearly imputed or measured. On multivariate regression, the association between imputed and measured Pao\textsubscript{2} varied by use of vasopressors and Spo\textsubscript{2}.{$<$}/p{$><$}h3{$>$}Conclusions{$<$}/h3{$><$}p{$>$}A nonlinear equation more accurately imputes Pao\textsubscript{2}/Fio\textsubscript{2} from Spo\textsubscript{2}/Fio\textsubscript{2} than linear or log-linear equations, with similar observed hospital mortality depending on Spo\textsubscript{2}/Fio\textsubscript{2} ratio vs measured Pao\textsubscript{2}/Fio\textsubscript{2} ratios. While further refinement through prospective validation is indicated, a nonlinear imputation appears superior to prior approaches to imputation.{$<$}/p{$>$}},
 author = {Brown, Samuel M. and Grissom, Colin K. and Moss, Marc and Rice, Todd W. and Schoenfeld, David and Hou, Peter C. and Thompson, B. Taylor and Brower, Roy G.},
 doi = {10.1016/j.chest.2016.01.003},
 file = {/Users/jkb/Zotero/storage/4PXFZFSN/Brown et al. - 2016 - Nonlinear Imputation of Pao2Fio2 From Spo2Fio2 A.pdf;/Users/jkb/Zotero/storage/ZIA598RR/Brown et al. - 2016 - Nonlinear Imputation of Pao2/Fio2 From Spo2/Fio2 A.html},
 ids = {brownnonlinearimputationpao22016a},
 issn = {0012-3692},
 journal = {CHEST},
 keyword = {acute respiratory distress syndrome,Adult,Aged,Blood Gas Analysis,Female,Hospital Mortality,Humans,Male,Middle Aged,Nonlinear Dynamics,Oximetry,Partial Pressure,Prognosis,pulse oximetry,Respiratory Distress Syndrome,respiratory failure,Severity of Illness Index,severity scores},
 langid = {english},
