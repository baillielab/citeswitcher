@article{finiganactivatedproteinmediates2005,
 abstract = {Increased endothelial cell (EC) permeability is central to the pathophysiology of inflammatory syndromes such as sepsis and acute lung injury (ALI). Activated protein C (APC), a serine protease critically involved in the regulation of coagulation and inflammatory processes, improves sepsis survival through an unknown mechanism. We hypothesized a direct effect of APC to both prevent increased EC permeability and to restore vascular integrity after edemagenic agonists. We measured changes in transendothelial electrical resistance (TER) and observed that APC produced concentration-dependent attenuation of TER reductions evoked by thrombin. We next explored known EC barrier-protective signaling pathways and observed dose-dependent APC-mediated increases in cortical myosin light chain (MLC) phosphorylation in concert with cortically distributed actin polymerization, findings highly suggestive of Rac GTPase involvement. We next determined that APC directly increases Rac1 activity, with inhibition of Rac1 activity significantly attenuating APC-mediated barrier protection to thrombin challenge. Finally, as these signaling events were similar to those evoked by the potent EC barrier-enhancing agonist, sphingosine 1-phosphate (S1P), we explored potential cross-talk between endothelial protein C receptor (EPCR) and S1P1, the receptors for APC and S1P, respectively. EPCR-blocking antibody (RCR-252) significantly attenuated both APC-mediated barrier protection and increased MLC phosphorylation. We next observed rapid, EPCR and PI 3-kinase-dependent, APC-mediated phosphorylation of S1P1 on threonine residues consistent with S1P1 receptor activation. Co-immunoprecipitation studies demonstrate an interaction between EPCR and S1P1 upon APC treatment. Targeted silencing of S1P1 expression using siRNA significantly reduced APC-mediated barrier protection against thrombin. These data suggest that novel EPCR ligation and S1P1 transactivation results in EC cytoskeletal rearrangement and barrier protection, components potentially critical to the improved survival of APC-treated patients with severe sepsis},
 author = {Finigan, J.H. and Dudek, S.M. and Singleton, P.A. and Chiang, E.T. and Jacobson, J.R. and Camp, S.M. and Ye, S.Q. and Garcia, J.G.},
 journal = {J Biol Chem.},
 keyword = {{Cells,Cultured},{Dose-Response Relationship,Drug},{Endothelium,Vascular},{Genes,Dominant},{Microscopy,Fluorescence},{Models,Biological},{Receptors,Cell Surface},{Receptors,Lysosphingolipid},{RNA,Small Interfering},Actins,Antibodies,blood,Blood Coagulation,Blood Coagulation Factors,chemistry,Critical Care,Cytoskeleton,Electric Impedance,Endothelium,Immunoprecipitation,injuries,Ligation,Light,Lung,metabolism,Myosin Light Chains,pathology,Permeability,Phosphorylation,Protein Binding,Protein C,rac GTP-Binding Proteins,rac1 GTP-Binding Protein,Rna,Sepsis,Serine,Signal Transduction,Syndrome,Threonine,Thrombin,Trans-Activation (Genetics),Transfection},
 month = {April},
 number = {17},
 pages = {17286--17293},
 title = {Activated Protein {{C}} Mediates Novel Lung Endothelial Barrier Enhancement: Role of Sphingosine 1-Phosphate Receptor Transactivation},
 volume = {280},
 year = {2005}
}

@article{finkanimalmodelssepsis2014,
 abstract = {Sepsis remains a common, serious, and heterogeneous clinical entity that is difficult to define adequately. Despite its importance as a public health problem, efforts to develop and gain regulatory approval for a specific therapeutic agent for the adjuvant treatment of sepsis have been remarkably unsuccessful. One step in the critical pathway for the development of a new agent for adjuvant treatment of sepsis is evaluation in an appropriate animal model of the human condition. Unfortunately, the animal models that have been used for this purpose have often yielded misleading findings. It is likely that there are multiple reasons for the discrepancies between the results obtained in tests of pharmacological agents in animal models of sepsis and the outcomes of human clinical trials. One of important reason may be that the changes in gene expression, which are triggered by trauma or infection, are different in mice, a commonly used species for preclinical testing, and humans. Additionally, many species, including mice and baboons, are remarkably resistant to the toxic effects of bacterial lipopolysaccharide, whereas humans are exquisitely sensitive. New approaches toward the use of animals for sepsis research are being investigated. But, at present, results from preclinical studies of new therapeutic agents for sepsis must be viewed with a degree of skepticism.},
 author = {Fink, Mitchell P.},
 doi = {10/gf2bdn},
 file = {/Users/jkb/Zotero/storage/4TIM3A9W/Fink - 2014 - Animal models of sepsis.pdf},
 issn = {2150-5608},
 journal = {Virulence},
 keyword = {{Disease Models, Animal},Animals,drotrecogin alfa (activated),endotoxin,Humans,lipopolysaccharide,Lipopolysaccharides,Mice,Monkey Diseases,Papio,platelet activating factor,Sepsis,Sheep,Sheep Diseases,tifacogin,tumor necrosis factor},
 langid = {english},
