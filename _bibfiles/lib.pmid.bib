 issn = {1465-6914},
 journal = {Genome Biology},
 keyword = {Algorithms,Animals,Mice,Proteins},
 pages = {S2},
 pmid = {18613946},
 title = {A Critical Assessment of {{Mus}} Musculus Gene Function Prediction Using Integrated Genomic Evidence},
 urldate = {2012-07-18},
 volume = {9 Suppl 1},
 year = {2008}
}

