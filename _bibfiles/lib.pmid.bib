@article{mclachlanoptimizingaerosolgene2007,
 abstract = {We have developed the sheep as a large animal model for optimizing cystic fibrosis gene therapy protocols. We administered aerosolized gene transfer agents (GTAs) to the ovine lung in order to test the delivery, efficacy, and safety of GTAs using a clinically relevant nebulizer. A preliminary study demonstrated GTA distribution and reporter gene expression throughout the lung after aerosol administration of plasmid DNA (pDNA):GL67 and pDNA:PEI complexes. A more comprehensive study examined the dose-response relationship for pDNA:PEI and assessed the influence of adjunct therapeutic agents. We found that the sheep model can differentiate between doses of GTA and that the anticholinergic, glycopyrrolate, enhanced transgene expression. Dose-related toxicity of GTA was reduced by aerosol administration compared to direct instillation. This large animal model will allow us to move toward clinical studies with greater confidence.},
