 doi = {10.1101/2020.05.08.20092866},
 journal = {medRxiv},
 month = {May},
 pmcid = {PMC7273284},
 pmid = {32511516},
 title = {Robust {{ACE2}} Protein Expression Localizes to the Motile Cilia of the Respiratory Tract Epithelia and Is Not Increased by {{ACE}} Inhibitors or Angiotensin Receptor Blockers},
