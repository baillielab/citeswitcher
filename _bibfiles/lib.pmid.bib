 month = {July},
 number = {Pt 1},
 pages = {65--70},
 title = {Inhibition of Staurosporine-Induced Apoptosis of Endothelial Cells by Activated Protein {{C}} Requires Protease-Activated Receptor-1 and Endothelial Cell Protein {{C}} Receptor},
