 langid = {english},
 month = {January},
 number = {19},
 pages = {2613--2614},
 pmid = {19605420},
 title = {Probabilistic Resolution of Multi-Mapping Reads in Massively Parallel Sequencing Data Using {{MuMRescueLite}}},
 urldate = {2016-01-22},
