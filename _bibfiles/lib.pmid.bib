@article{pengbroadstrongmemory2020,
 abstract = {The development of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) vaccines and therapeutics will depend on understanding viral immunity. We studied T cell memory in 42 patients following recovery from COVID-19 (28 with mild disease and 14 with severe disease) and 16 unexposed donors, using interferon-{$\gamma$}-based assays with peptides spanning SARS-CoV-2 except ORF1. The breadth and magnitude of T cell responses were significantly higher in severe as compared with mild cases. Total and spike-specific T cell responses correlated with spike-specific antibody responses. We identified 41 peptides containing CD4+ and/or CD8+ epitopes, including six immunodominant regions. Six optimized CD8+ epitopes were defined, with peptide--MHC pentamer-positive cells displaying the central and effector memory phenotype. In mild cases, higher proportions of SARS-CoV-2-specific CD8+ T cells were observed. The identification of T cell responses associated with milder disease will support an understanding of protective immunity and highlights the potential of including non-spike proteins within future COVID-19 vaccine design.},
 author = {Peng, Yanchun and Mentzer, Alexander J. and Liu, Guihai and Yao, Xuan and Yin, Zixi and Dong, Danning and Dejnirattisai, Wanwisa and Rostron, Timothy and Supasa, Piyada and Liu, Chang and {L{\'o}pez-Camacho}, C{\'e}sar and {Slon-Campos}, Jose and Zhao, Yuguang and Stuart, David I. and Paesen, Guido C. and Grimes, Jonathan M. and Antson, Alfred A. and Bayfield, Oliver W. and Hawkins, Dorothy E. D. P. and Ker, De-Sheng and Wang, Beibei and Turtle, Lance and Subramaniam, Krishanthi and Thomson, Paul and Zhang, Ping and Dold, Christina and Ratcliff, Jeremy and Simmonds, Peter and {de Silva}, Thushan and Sopp, Paul and Wellington, Dannielle and Rajapaksa, Ushani and Chen, Yi-Ling and Salio, Mariolina and Napolitani, Giorgio and Paes, Wayne and Borrow, Persephone and Kessler, Benedikt M. and Fry, Jeremy W. and Schwabe, Nikolai F. and Semple, Malcolm G. and Baillie, J. Kenneth and Moore, Shona C. and Openshaw, Peter J. M. and Ansari, M. Azim and Dunachie, Susanna and Barnes, Eleanor and Frater, John and Kerr, Georgina and Goulder, Philip and Lockett, Teresa and Levin, Robert and Zhang, Yonghong and Jing, Ronghua and Ho, Ling-Pei and Cornall, Richard J. and Conlon, Christopher P. and Klenerman, Paul and Screaton, Gavin R. and Mongkolsapaya, Juthathip and McMichael, Andrew and Knight, Julian C. and Ogg, Graham and Dong, Tao},
