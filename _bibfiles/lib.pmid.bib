 doi = {10.1016/j.biochi.2013.11.006},
 file = {/Users/jkb/Zotero/storage/54QGEX88/S0300908413004021.html},
 issn = {0300-9084},
 journal = {Biochimie},
 keyword = {Docosatrienes,Inflammation,Maresin,Protectin,PUFA metabolites},
 month = {April},
 pages = {1--7},
 title = {Confusion between Protectin {{D1}} ({{PD1}}) and Its Isomer Protectin {{DX}} ({{PDX}}). {{An}} Overview on the Dihydroxy-Docosatrienes Described to Date},
 urldate = {2014-05-19},
 volume = {99},
 year = {2014}
}

