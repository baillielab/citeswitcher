 issn = {0028-0836},
 journal = {Nature},
 langid = {english},
 month = {March},
 number = {7237},
 pages = {475--480},
 title = {Crystal Structure of Human Spliceosomal {{U1 snRNP}} at 5.5\,{{{\AA}}} Resolution},
 urldate = {2014-07-31},
