 keyword = {{Infusions,Intravenous},{Shock,Cardiogenic},{Spectrometry,Fluorescence},adverse effects,Belgium,blood,Blood Pressure,blood supply,Capillaries,Cardiomyopathies,Cardiopulmonary Bypass,Case Report,Central Venous Pressure,drug effects,drug therapy,etiology,Fluorescence Polarization,Heart Rate,Heart Transplantation,Hemodynamic Processes,methods,Microcirculation,Mouth Floor,pharmacology,physiopathology,Pressure,Pulmonary Wedge Pressure,Shock,surgery,therapeutic use,Vasoconstrictor Agents,Vasopressins},
 month = {June},
