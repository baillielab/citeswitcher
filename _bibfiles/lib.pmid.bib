 doi = {10.1126/sciadv.aax0301},
 file = {/Users/jkb/Zotero/storage/4QWN3W5P/Klarić et al. - 2020 - Glycosylation of immunoglobulin G is regulated by .pdf;/Users/jkb/Zotero/storage/SE85IA8H/Klarić et al. - 2020 - Glycosylation of immunoglobulin G is regulated by .html},
 issn = {2375-2548},
