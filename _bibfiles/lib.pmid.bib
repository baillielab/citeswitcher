 issn = {0092-8674},
 journal = {Cell},
 keyword = {ACE2,coronavirus,COVID-19,entry,neutralization,priming,SARS-CoV-2,spike,TMPRSS2},
 langid = {english},
 month = {March},
 title = {{{SARS-CoV-2 Cell Entry Depends}} on {{ACE2}} and {{TMPRSS2}} and {{Is Blocked}} by a {{Clinically Proven Protease Inhibitor}}},
