 issn = {0022-1899, 1537-6613},
 journal = {Journal of Infectious Diseases},
 langid = {english},
 month = {January},
 number = {3},
 pages = {586--593},
 pmid = {10438343},
 shorttitle = {Nasal {{Cytokine}} and {{Chemokine Responses}} in {{Experimental Influenza A Virus Infection}}},
 title = {Nasal {{Cytokine}} and {{Chemokine Responses}} in {{Experimental Influenza A Virus Infection}}: {{Results}} of a {{Placebo-Controlled Trial}} of {{Intravenous Zanamivir Treatment}}},
 urldate = {2013-05-21},
