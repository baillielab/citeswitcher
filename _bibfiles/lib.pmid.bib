 keyword = {{Rats, Wistar},{Statistics, Nonparametric},Analysis of Variance,Animals,Dexmedetomidine,Malondialdehyde,Nitric Oxide,Peroxidase,Random Allocation,Rats,Reperfusion Injury,Surgical Flaps},
 langid = {english},
