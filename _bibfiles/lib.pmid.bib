 issn = {1946-6234, 1946-6242},
 journal = {Science Translational Medicine},
 langid = {english},
 month = {January},
 number = {322},
 pages = {322ra11-322ra11},
 pmid = {26791949},
 title = {Host Gene Expression Classifiers Diagnose Acute Respiratory Illness Etiology},
 urldate = {2018-09-25},
 volume = {8},
 year = {2016}
}

