 keyword = {{Immunity, Innate},{Polymorphism, Single Nucleotide},Adaptive Immunity,Alleles,Alzheimer Disease,Autoimmune Diseases,autoimmunity,CD4-Positive T-Lymphocytes,Ethnic Groups,Genetic Predisposition to Disease,Genome-Wide Association Study,Humans,Monocytes,multiple sclerosis,Neurodegenerative Diseases,Parkinson Disease,Quantitative trait loci,Rheumatic Fever,Transcriptome},
