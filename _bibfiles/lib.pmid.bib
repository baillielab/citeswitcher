 file = {/Users/jkb/Zotero/storage/IB86HK8N/Hou et al. - 2020 - New insights into genetic susceptibility of COVID-.html},
 issn = {1741-7015},
 journal = {BMC Medicine},
 month = {July},
 number = {1},
 pages = {216},
 shorttitle = {New Insights into Genetic Susceptibility of {{COVID-19}}},
 title = {New Insights into Genetic Susceptibility of {{COVID-19}}: An {{ACE2}} and {{TMPRSS2}} Polymorphism Analysis},
