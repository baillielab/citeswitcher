 month = {August},
 number = {2},
 pages = {268--278},
 pmid = {19524996},
 title = {Budding of Filamentous and Non-Filamentous Influenza {{A}} Virus Occurs via a {{VPS4}} and {{VPS28-independent}} Pathway},
