 doi = {10.1126/science.abf2946},
 file = {/Users/jkb/Zotero/storage/JFKCXV79/Plessis et al. - 2021 - Establishment and lineage dynamics of the SARS-CoV.pdf;/Users/jkb/Zotero/storage/ZDN24BS3/Plessis et al. - 2021 - Establishment and lineage dynamics of the SARS-CoV.html},
 issn = {0036-8075, 1095-9203},
