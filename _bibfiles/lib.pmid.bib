 doi = {10/f8gsjv},
 file = {/Users/jkb/Zotero/storage/BB6ZCV5T/Savva et al. - 2016 - Functional polymorphisms of macrophage migration i.pdf;/Users/jkb/Zotero/storage/Q45B2V2E/3597.html},
 issn = {0027-8424, 1091-6490},
 journal = {Proceedings of the National Academy of Sciences},
 keyword = {innate immunity,macrophage migration inhibitory factor,meningitis,polymorphism,sepsis},
 langid = {english},
 month = {March},
 number = {13},
 pages = {3597--3602},
 pmid = {26976591},
 title = {Functional Polymorphisms of Macrophage Migration Inhibitory Factor as Predictors of Morbidity and Mortality of Pneumococcal Meningitis},
