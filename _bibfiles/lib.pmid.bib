 issn = {0305-1048, 1362-4962},
 journal = {Nucleic Acids Research},
 langid = {english},
 month = {January},
 number = {suppl 1},
 pages = {D590-D598},
 pmid = {16381938},
 shorttitle = {The {{UCSC Genome Browser Database}}},
 title = {The {{UCSC Genome Browser Database}}: Update 2006},
