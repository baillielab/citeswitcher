 issn = {0305-1048, 1362-4962},
 journal = {Nucleic Acids Research},
 langid = {english},
 month = {December},
 pages = {gkt1271},
 pmid = {24311566},
 title = {Identification of Truncated Forms of {{U1 snRNA}} Reveals a Novel {{RNA}} Degradation Pathway during {{snRNP}} Biogenesis},
