 journal = {Am. J. Respir. Crit. Care Med.},
 month = {August},
 number = {4},
 pages = {476--480},
 title = {Pneumococcal {{Septic Shock Is Associated}} with the {{Interleukin-10-1082 Gene Promoter Polymorphism}}},
