 title = {A {{Canadian Critical Care Trials Group}} Project in Collaboration with the International Forum for Acute Care Trialists - {{Collaborative H1N1 Adjuvant Treatment}} Pilot Trial ({{CHAT}}): Study Protocol and Design of a Randomized Controlled Trial},
