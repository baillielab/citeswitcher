 issn = {1878-3511},
 journal = {International Journal of Infectious Diseases: IJID: Official Publication of the International Society for Infectious Diseases},
 month = {March},
 number = {3},
 pages = {e204-208},
 pmid = {22269998},
 title = {Role of Tumor Necrosis Factor Gene Single Nucleotide Polymorphisms in the Natural Course of 2009 Influenza {{A H1N1}} Virus Infection},
