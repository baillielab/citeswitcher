 pages = {779--797},
 pmcid = {PMC3824120},
 pmid = {24210251},
 shorttitle = {Beyond {{GWASs}}},
 title = {Beyond {{GWASs}}: {{Illuminating}} the {{Dark Road}} from {{Association}} to {{Function}}},
 urldate = {2015-11-16},
 volume = {93},
 year = {2013}
}

