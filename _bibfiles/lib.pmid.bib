}

@article{sharpevaluatingevidencevirus2011,
 abstract = {There is currently much debate about the timescales of virus evolution. Some viruses may have co-evolved with human populations for tens of thousands of years, or even with our primate ancestors over many millions of years. However, calibrations of the rate of short-term virus evolution lead to estimates of dates for viral ancestors that are orders of magnitude more recent, and a number of the proposed host--virus co-divergence scenarios have been questioned. Other considerations indicate that the proposed recent timescales for virus evolution are implausible, that co-divergence has been rejected prematurely, and that long-term evolutionary rates are very much slower than short-term rates. There is a need to understand the biological basis of this discrepancy and to develop evolutionary models that can accommodate this.},
 author = {Sharp, Paul M and Simmonds, Peter},
 doi = {10.1016/j.coviro.2011.10.018},
 file = {/Users/jkb/Zotero/storage/RVV7A2HT/Sharp and Simmonds - 2011 - Evaluating the evidence for virushost co-evolutio.pdf;/Users/jkb/Zotero/storage/U2RDIJQE/Sharp and Simmonds - 2011 - Evaluating the evidence for virushost co-evolutio.html},
 issn = {1879-6257},
 journal = {Current Opinion in Virology},
 month = {November},
 number = {5},
 pages = {436--441},
 title = {Evaluating the Evidence for Virus/Host Co-Evolution},
 urldate = {2012-07-26},
 volume = {1},
 year = {2011}
}

