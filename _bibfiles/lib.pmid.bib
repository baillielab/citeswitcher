 pmid = {19435433},
 shorttitle = {Clinical Features of Human Influenza {{A}} ({{H5N1}}) Infection in {{Vietnam}}},
 title = {Clinical Features of Human Influenza {{A}} ({{H5N1}}) Infection in {{Vietnam}}: 2004-2006},
 urldate = {2012-06-27},
