 month = {March},
 number = {3},
 pages = {301--310},
 title = {Inflammatory Cytokines in {{BAL}} Fluid and Pulmonary Hemodynamics in High-Altitude Pulmonary Edema},
 volume = {111},
 year = {1998}
}

@article{kubol1retrotranspositionnondividing2006,
 abstract = {Whether long interspersed element-1 (L1 or LINE-1) retrotransposition can occur in quiescent, nondividing, and/or terminally differentiated somatic cells has remained an unanswered fundamental question in human genetics. Here, we used a ubiquitously active phosphoglycerate kinase-1 promoter to drive the expression of a highly active human L1 element from an adenovirus-L1 hybrid vector. This vector system achieved retrotransposition in up to 91\% of actively growing immortalized cells, and we demonstrated that L1 retrotransposition can be suppressed by the reverse transcriptase inhibitor 3{$\prime$}-azido-3{$\prime$}-deoxythymidine. This adenovirus vector enabled efficient delivery of the L1 element into differentiated primary human somatic cells and G1/S-arrested cells, resulting in retrotransposition in both cases; however, it was not detected in G0-arrested cells. Thus, these data indicate that L1 retrotransposition can occur in nondividing somatic cells.},
 author = {Kubo, Shuji and {del Carmen Seleme}, Maria and Soifer, Harris S. and Perez, Jos{\'e} Luis Garcia and Moran, John V. and Kazazian, Haig H. and Kasahara, Noriyuki},
 doi = {10.1073/pnas.0601954103},
