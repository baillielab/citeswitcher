@article{fenggeneticapproachassociation2019,
 abstract = {{$<$}h3{$>$}Importance{$<$}/h3{$><$}p{$>$}Whether the\emph{PCSK9}gene is associated with the progress from infection to sepsis is unknown to date.{$<$}/p{$><$}h3{$>$}Objective{$<$}/h3{$><$}p{$>$}To test the associations between\emph{PCSK9}genetic variants, a\emph{PCSK9}genetic risk score (GRS), or genetically estimated\emph{PCSK9}expression levels and the risk of sepsis among patients admitted to a hospital with infection.{$<$}/p{$><$}h3{$>$}Design, Setting, and Participants{$<$}/h3{$><$}p{$>$}This retrospective cohort study used deidentified electronic health records to identify patients admitted to Vanderbilt University Medical Center, Nashville, Tennessee, with infection. Patients were white adults, had a code indicating infection from the\emph{International Classification of Diseases, Ninth Revision, Clinical Modification}, or the\emph{International Statistical Classification of Diseases, Tenth Revision, Clinical Modification}, and received an antibiotic within 1 day of hospital admission (N = 61 502). Data were collected from January 1, 1993, through December 31, 2017, and analyzed from April 1, 2018, to March 16, 2019.{$<$}/p{$><$}h3{$>$}Exposures{$<$}/h3{$><$}p{$>$}Four known\emph{PCSK9}functional variants, a GRS for\emph{PCSK9}, and genetically estimated\emph{PCSK9}expression.{$<$}/p{$><$}h3{$>$}Main Outcomes and Measures{$<$}/h3{$><$}p{$>$}The primary outcome was sepsis; secondary outcomes included cardiovascular failure and in-hospital death.{$<$}/p{$><$}h3{$>$}Results{$<$}/h3{$><$}p{$>$}Of patients with infection, genotype information was available in 10 922 white patients for\emph{PCSK9}functional variants (5628 men [51.5\%]; mean [SD] age, 60.1 [15.7] years), including 7624 patients with\emph{PCSK9}GRS and 6033 patients with estimated\emph{PCSK9}expression. Of these, 3391 developed sepsis, 835 developed cardiovascular failure, and 366 died during hospitalization. None of the 4 functional\emph{PCSK9}variants were significantly associated with sepsis, cardiovascular failure, or in-hospital death, with or without adjustment for (1) age and sex or (2) age, sex, and Charlson-Deyo comorbidities (in model adjusted for age, sex, and comorbidities, odds ratios for any loss-of function variant were 0.96 [95\% CI, 0.88-1.04] for sepsis, 1.05 [95\% CI, 0.90-1.22] for cardiovascular failure, and 0.89 [95\% CI, 0.72-1.11] for death). Similarly, neither the\emph{PCSK9}GRS nor genetically estimated\emph{PCSK9}expression were significantly associated with sepsis, cardiovascular failure, or in-hospital death in any of the analysis models. For GRS, in the full model adjusted for age, sex, and comorbidities, the odds ratios were 1.01 for sepsis (95\% CI, 0.96-1.06;\emph{P} = .70), 1.03 for cardiovascular failure (95\% CI, 0.95-1.12;\emph{P} = .48), and 1.05 for in-hospital death (95\% CI, 0.92-1.19;\emph{P} = .50). For genetically estimated\emph{PCSK9}expression, in the full model adjusted for age, sex, and comorbidities, the odds ratios were 1.01 for sepsis (95\% CI, 0.95-1.06;\emph{P} = .86), 0.96 for cardiovascular failure (95\% CI, 0.88-1.05;\emph{P} = .41), and 0.99 for in-hospital death (95\% CI, 0.87-1.14;\emph{P} = .94).{$<$}/p{$><$}h3{$>$}Conclusions and Relevance{$<$}/h3{$><$}p{$>$}In this study,\emph{PCSK9}genetic variants were not significantly associated with risk of sepsis or the outcomes of sepsis in patients hospitalized with infection.{$<$}/p{$>$}},
 author = {Feng, QiPing and Wei, Wei-Qi and Chaugai, Sandip and Leon, Barbara G. Carranza and Kawai, Vivian and Leon, Daniel A. Carranza and Jiang, Lan and Zhong, Xue and Liu, Ge and Ihegword, Andrea and Shaffer, Christian M. and Linton, MacRae F. and Chung, Cecilia P. and Stein, C. Michael},
 doi = {10/ggt483},
 file = {/Users/jkb/Zotero/storage/CI4V2XZ4/Feng et al. - 2019 - A Genetic Approach to the Association Between PCSK.pdf;/Users/jkb/Zotero/storage/DSK4MWE2/Feng et al. - 2019 - A Genetic Approach to the Association Between PCSK.html},
 journal = {JAMA Network Open},
 langid = {english},
