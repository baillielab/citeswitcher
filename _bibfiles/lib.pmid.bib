 issn = {0041-1345},
 journal = {Transplantation Proceedings},
 keyword = {Liver transplantation,Post-COVID-19 cholangiopathy,Secondary sclerosing cholangitis in critically ill patients (SSC-CIP)},
 langid = {english},
 month = {March},
 shorttitle = {A {{Case Report}} of {{Post- COVID-19 Cholangiopathy}}},
 title = {A {{Case Report}} of {{Post- COVID-19 Cholangiopathy}}: {{A New Indication}} for {{Liver Transplantation}}},
 urldate = {2021-03-21},
 year = {2021}
