 doi = {10.1371/journal.pgen.1002793},
 file = {/Users/jkb/Zotero/storage/X9QSPG39/Voight et al. - 2012 - The Metabochip, a Custom Genotyping Array for Gene.pdf},
 journal = {PLoS Genet},
 month = {August},
 number = {8},
 pages = {e1002793},
 title = {The {{Metabochip}}, a {{Custom Genotyping Array}} for {{Genetic Studies}} of {{Metabolic}}, {{Cardiovascular}}, and {{Anthropometric Traits}}},
 urldate = {2015-04-07},
