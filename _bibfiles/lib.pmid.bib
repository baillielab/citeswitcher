 doi = {10.1101/2020.09.04.20188318},
 file = {/Users/jkb/Zotero/storage/2YSAX64C/Shelton et al. - 2020 - Trans-ethnic analysis reveals genetic and non-gene.pdf;/Users/jkb/Zotero/storage/K9QHFJCS/2020.09.04.html},
 journal = {medRxiv},
 langid = {english},
 month = {September},
