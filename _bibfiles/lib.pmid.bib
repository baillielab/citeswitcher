 issn = {1073-449X},
 journal = {American Journal of Respiratory and Critical Care Medicine},
 keyword = {Africa,critical care,Critical care,Ebola,Outbreak,Viral Hemorrhagic Fever},
 month = {August},
 shorttitle = {Caring for {{Critically Ill Patients}} with {{Ebola Virus Disease}}},
 title = {Caring for {{Critically Ill Patients}} with {{Ebola Virus Disease}}: {{Perspectives}} from {{West Africa}}.},
