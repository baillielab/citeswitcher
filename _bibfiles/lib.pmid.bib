@article{bruceorf59dnapolymerase2009,
 abstract = {ORF59 DNA polymerase processivity factor of the human rhadinovirus, Kaposi's sarcoma-associated herpesvirus (KSHV), is required for efficient copying of the genome during virus replication. KSHV ORF59 is antigenic in the infected host and is used as a marker for virus activation and replication.},
