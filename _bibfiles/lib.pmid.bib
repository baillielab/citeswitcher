 issn = {0007-0912, 1471-6771},
 journal = {British Journal of Anaesthesia},
 keyword = {{intensive care, tracheostomy},airway,audit,brain damage,complications,cricothyroidotomy,death,emergency department},
 langid = {english},
 month = {January},
 number = {5},
 pages = {617--631},
 pmid = {21447488},
 shorttitle = {Major Complications of Airway Management in the {{UK}}},
 title = {Major Complications of Airway Management in the {{UK}}: Results of the {{Fourth National Audit Project}} of the {{Royal College}} of {{Anaesthetists}} and the {{Difficult Airway Society}}. {{Part}} 1: {{Anaesthesia}}},
