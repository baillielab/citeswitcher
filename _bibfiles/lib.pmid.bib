 volume = {211},
 year = {2014}
}

@techreport{heatonsrsfproteinkinases2020,
 abstract = {ABSTRACT           Antiviral therapeutics against SARS-CoV-2 are needed to treat the pandemic disease COVID-19. Pharmacological targeting of a host factor required for viral replication can suppress viral spread with a low probability of viral mutation leading to resistance. Here, we performed a genome-wide screen in human lung epithelial cells to identify potential host therapeutic targets. We report that the kinase SRPK1, together with the closely related SRPK2, are jointly essential for SARS-CoV-2 replication; inhibition of SRPK1/2 with small molecules led to a dramatic decrease (more than 100,000-fold) in SARS-CoV-2 virus production in immortalized and primary human lung cells. Subsequent biochemical studies revealed that SPRK1/2 phosphorylate the viral nucleocapsid (N) protein at sites highly conserved across human coronaviruses and, due to this conservation, even a distantly related coronavirus was highly sensitive to an SPRK1/2 inhibitor. Together, these data suggest that SRPK1/2-targeted therapies may be an efficacious strategy to prevent or treat COVID-19 and other coronavirus-mediated diseases.},
 author = {Heaton, Brook E. and Trimarco, Joseph D. and Hamele, Cait E. and Harding, Alfred T. and Tata, Aleksandra and Zhu, Xinyu and Tata, Purushothama Rao and Smith, Clare M. and Heaton, Nicholas S.},
 doi = {10.1101/2020.08.14.251207},
 file = {/Users/jkb/Zotero/storage/F4HJZW5F/Heaton et al. - 2020 - SRSF protein kinases 1 and 2 are essential host fa.pdf},
 institution = {Microbiology},
 langid = {english},
 month = {August},
 title = {{{SRSF}} Protein Kinases 1 and 2 Are Essential Host Factors for Human Coronaviruses Including {{SARS-CoV-2}}},
 type = {Preprint},
 urldate = {2020-09-21},
 year = {2020}
}

