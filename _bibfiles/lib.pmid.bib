 journal = {Nature},
 keyword = {Autoimmunity,Body Mass Index,COVID-19,Critical Illness,Female,Genetic Loci,Genetic Predisposition to Disease,Genome-Wide Association Study,Geographic Mapping,Hospitalization,Host-Pathogen Interactions,Humans,Inflammation,Information Dissemination,Male,Multifactorial Inheritance,Racial Groups,SARS-CoV-2,Smoking},
 langid = {english},
