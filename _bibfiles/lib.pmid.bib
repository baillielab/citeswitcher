 doi = {10.1056/NEJMoa1100066},
 eprint = {21524210},
 eprinttype = {pubmed},
 issn = {1533-4406},
 journal = {The New England Journal of Medicine},
 keyword = {{Genes, Dominant},{Leukocytes, Mononuclear},{Models, Molecular},Adolescent,Adult,Amino Acid Sequence,Animals,Antigen-Presenting Cells,BCG Vaccine,Dendritic Cells,Female,Humans,Immunologic Deficiency Syndromes,Infant,Interferon Regulatory Factors,Interleukin-12,Male,Mutation,Mycobacterium Infections,Pedigree,Protein Conformation,Sequence Alignment},
 month = {July},
