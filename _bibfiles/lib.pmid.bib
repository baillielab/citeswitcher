@article{watanabeinfluenzavirushostinteractome2014,
 abstract = {Summary Host factors required for viral replication are ideal drug targets because they are less likely than viral proteins to mutate under drug-mediated selective pressure. Although genome-wide screens have identified host proteins involved in influenza virus replication, limited mechanistic understanding of how these factors affect influenza has hindered potential drug development. We conducted a systematic analysis to identify and validate host factors that associate with influenza virus proteins and affect viral replication. After identifying over 1,000 host factors that coimmunoprecipitate with specific viral proteins, we generated a network of virus-host protein interactions based on the stage of the viral life cycle affected upon host factor downregulation. Using compounds that inhibit these host factors, we validated several proteins, notably Golgi-specific brefeldin A-resistant~guanine nucleotide exchange factor 1 (GBF1) and JAK1, as potential antiviral drug targets. Thus, virus-host interactome screens are powerful strategies to identify targetable host factors and guide antiviral drug development.},
 author = {Watanabe, Tokiko and Kawakami, Eiryo and Shoemaker, Jason~E. and Lopes, Tiago~J. S. and Matsuoka, Yukiko and Tomita, Yuriko and {Kozuka-Hata}, Hiroko and Gorai, Takeo and Kuwahara, Tomoko and Takeda, Eiji and Nagata, Atsushi and Takano, Ryo and Kiso, Maki and Yamashita, Makoto and {Sakai-Tagawa}, Yuko and Katsura, Hiroaki and Nonaka, Naoki and Fujii, Hiroko and Fujii, Ken and Sugita, Yukihiko and Noda, Takeshi and Goto, Hideo and Fukuyama, Satoshi and Watanabe, Shinji and Neumann, Gabriele and Oyama, Masaaki and Kitano, Hiroaki and Kawaoka, Yoshihiro},
 doi = {10.1016/j.chom.2014.11.002},
