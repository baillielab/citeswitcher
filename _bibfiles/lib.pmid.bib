 keyword = {{Data Interpretation, Statistical},{Emergency Service, Hospital},{Respiration, Artificial},Adult,Aged,Blood Gas Analysis,Female,Humans,Hypoxia,Intensive Care Units,Male,Middle Aged,Oximetry,Prospective Studies,Respiratory Distress Syndrome,Severity of Illness Index},
 langid = {english},
 month = {August},
 number = {8},
