 pages = {13--19},
 pmid = {22170954},
 shorttitle = {Association between Use of Statins and Mortality among Patients Hospitalized with Laboratory-Confirmed Influenza Virus Infections},
 title = {Association between Use of Statins and Mortality among Patients Hospitalized with Laboratory-Confirmed Influenza Virus Infections: A Multistate Study},
