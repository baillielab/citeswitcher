@article{tanggenebasedtestassociation2012,
 abstract = {Motivation: Canonical correlation analysis (CCA) measures the association between two sets of multidimensional variables. We reasoned that CCA could provide an efficient and powerful approach for both univariate and multivariate gene-based tests of association without the need for permutation testing. Results: Compared with a commonly used permutation-based approach, CCA (i) is faster; (ii) has appropriate type-I error rate for normally distributed quantitative traits; (iii) provides comparable power for small to medium-sized genes ({$<$}100 kb); (iv) provides greater power when the causal variants are uncommon; (v) provides considerably less power for larger genes ({$\geq$}100 kb) when the causal variants have a broad minor allele frequency (MAF) spectrum. Application to a GWAS of leukocyte levels identified SAFB and a histone gene cluster as novel putative loci harboring multiple independent variants regulating lymphocyte and neutrophil counts. Availability: http://genepi.qimr.edu.au/staff/manuelF/gene/main.html Contact: manuel.ferreira@qimr.edu.au Supplementary information: Supplementary material is available at Bioinformatics online.},
 author = {Tang, Clara S. and Ferreira, Manuel A. R.},
 doi = {10.1093/bioinformatics/bts051},
 file = {/Users/jkb/Zotero/storage/J8XTCT7N/Tang_Ferreira_2012_A gene-based test of association using canonical correlation analysis.pdf;/Users/jkb/Zotero/storage/Z9FVMMX6/845.html},
 issn = {1367-4803, 1460-2059},
 journal = {Bioinformatics},
 langid = {english},
 month = {March},
 number = {6},
 pages = {845--850},
 title = {A Gene-Based Test of Association Using Canonical Correlation Analysis},
 urldate = {2012-09-03},
 volume = {28},
 year = {2012}
}

