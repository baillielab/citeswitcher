 issn = {0092-8674},
 journal = {Cell},
 month = {July},
 number = {1},
 pages = {25--36},
 shorttitle = {Evo-{{Devo}} and an {{Expanding Evolutionary Synthesis}}},
 title = {Evo-{{Devo}} and an {{Expanding Evolutionary Synthesis}}: {{A Genetic Theory}} of {{Morphological Evolution}}},
