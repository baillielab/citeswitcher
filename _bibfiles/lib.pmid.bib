@article{wubonemorphogeneticprotein2019,
 abstract = {Bone morphogenetic protein signaling has long been established as a crucial pathway during embryonic development. In recent years, our knowledge of the function of bone morphogenetic protein signaling has expanded dramatically beyond solely its important role in development. Today, the pathway is known to have important homeostatic functions across multiple different tissues in the adult. Even more importantly, bone morphogenetic protein signaling is now known to function as a driver of diseases in the adult spanning different organ systems. In this review, we will explore the functions of bone morphogenetic protein signaling in diseases of inflammation. Through this exploration, we will highlight the value and challenges in targeting bone morphogenetic protein signaling for therapeutic interventions.},
