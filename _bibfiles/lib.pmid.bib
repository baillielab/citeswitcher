@article{arabicorticosteroidtherapycritically2018,
 abstract = {RATIONALE: Corticosteroid therapy is commonly used among critically ill patients with Middle East Respiratory Syndrome (MERS), but its impact on outcomes is uncertain. Analyses of observational studies often do not account for patients' clinical condition at the time of corticosteroid therapy initiation. OBJECTIVES: To investigate the association of corticosteroid therapy on mortality and on MERS coronavirus RNA clearance in critically ill patients with MERS. METHODS: ICU patients with MERs were included from 14 Saudi Arabian centers between September 2012 and October 2015. We performed marginal structural modeling to account for baseline and time-varying confounders. MEASUREMENTS AND MAIN RESULTS: Of 309 patients, 151 received corticosteroids. Corticosteroids were initiated at a median of 3.0 days (quartile 1 [Q1]-Q3, 1.0-7.0) from ICU admission. Patients who received corticosteroids were more likely to receive invasive ventilation (141 of 151 [93.4\%] vs. 121 of 158 [76.6\%]; P\,{$<$}\,0.0001) and had higher 90-day crude mortality (112 of 151 [74.2\%] vs. 91 of 158 [57.6\%]; P\,=\,0.002). Using marginal structural modeling, corticosteroid therapy was not significantly associated with 90-day mortality (adjusted odds ratio, 0.75; 95\% confidence interval, 0.52-1.07; P\,=\,0.12) but was associated with delay in MERS coronavirus RNA clearance (adjusted hazard ratio, 0.35; 95\% CI, 0.17-0.72; P\,=\,0.005). CONCLUSIONS: Corticosteroid therapy in patients with MERS was not associated with a difference in mortality after adjustment for time-varying confounders but was associated with delayed MERS coronavirus RNA clearance. These findings highlight the challenges and importance of adjusting for baseline and time-varying confounders when estimating clinical effects of treatments using observational studies.},
 author = {Arabi, Yaseen M. and Mandourah, Yasser and {Al-Hameed}, Fahad and Sindi, Anees A. and Almekhlafi, Ghaleb A. and Hussein, Mohamed A. and Jose, Jesna and Pinto, Ruxandra and {Al-Omari}, Awad and Kharaba, Ayman and Almotairi, Abdullah and Al Khatib, Kasim and Alraddadi, Basem and Shalhoub, Sarah and Abdulmomen, Ahmed and Qushmaq, Ismael and Mady, Ahmed and Solaiman, Othman and {Al-Aithan}, Abdulsalam M. and {Al-Raddadi}, Rajaa and Ragab, Ahmed and Balkhy, Hanan H. and Al Harthy, Abdulrahman and Deeb, Ahmad M. and Al Mutairi, Hanan and {Al-Dawood}, Abdulaziz and Merson, Laura and Hayden, Frederick G. and Fowler, Robert A. and {Saudi Critical Care Trial Group}},
 doi = {10/gc9gw6},
 issn = {1535-4970},
