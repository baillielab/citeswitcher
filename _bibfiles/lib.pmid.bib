 issn = {1074-7613},
 journal = {Immunity},
 month = {February},
 number = {2},
 pages = {274--288},
 title = {Transcriptome-{{Based Network Analysis Reveals}} a {{Spectrum Model}} of {{Human Macrophage Activation}}},
