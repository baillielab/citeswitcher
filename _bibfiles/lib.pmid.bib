 issn = {1548-7105},
 journal = {Nature Methods},
 keyword = {Gene expression,Machine learning,Software,Transcriptomics},
 langid = {english},
 month = {October},
 number = {10},
 pages = {1196--1203},
 title = {Effective Gene Expression Prediction from Sequence by Integrating Long-Range Interactions},
 urldate = {2023-10-16},
 volume = {18},
 year = {2021}
}

