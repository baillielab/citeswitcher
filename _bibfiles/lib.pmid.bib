 issn = {1529-2908},
 journal = {Nature Immunology},
 keyword = {{Candidiasis, Invasive},{Immunity, Innate},Adenosine Triphosphate,Adult,Animals,Antifungal Agents,Aspergillosis,Cytokines,Endotoxemia,Energy Metabolism,Escherichia coli Infections,Female,Glycolysis,Humans,Immune Tolerance,Immunoblotting,Innate immunity,Interferon-gamma,Lactic Acid,Leukocytes,Lipopolysaccharides,Macrophages,Male,Mice,Middle Aged,Monocytes,Monocytes and macrophages,NAD,Oxidative Phosphorylation,Oxygen Consumption,Prospective Studies,Sepsis,Transcriptome,Young Adult},
