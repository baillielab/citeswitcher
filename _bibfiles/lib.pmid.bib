@article{figueiredoanthracyclinesinducedna2013,
 abstract = {Summary Severe sepsis remains a poorly understood systemic inflammatory condition with high mortality rates and~limited therapeutic options in addition to organ support measures. Here we show that the clinically approved group of anthracyclines acts therapeutically at a low dose regimen to confer robust protection against severe sepsis in mice. This salutary effect is strictly dependent on the activation of DNA damage response and autophagy pathways in the lung, as demonstrated by deletion of the ataxia telangiectasia mutated (Atm) or the autophagy-related protein 7 (Atg7) specifically in this organ. The protective effect of anthracyclines occurs irrespectively of pathogen burden, conferring disease tolerance to severe sepsis. These findings demonstrate that DNA damage responses, including the ATM and Fancony Anemia pathways, are important modulators of immune responses and might be exploited to confer protection to inflammation-driven conditions, including severe sepsis.},
 author = {Figueiredo, Nuno and Chora, Angelo and Raquel, Helena and Pejanovic, Nadja and Pereira, Pedro and Hartleben, Bj{\"o}rn and {Neves-Costa}, Ana and Moita, Catarina and Pedroso, Dora and Pinto, Andreia and Marques, Sofia and Faridi, Hafeez and Costa, Paulo and Gozzelino, Raffaella and Zhao, Jimmy~L. and Soares, Miguel~P. and {Gama-Carvalho}, Margarida and Martinez, Jennifer and Zhang, Qingshuo and D{\"o}ring, Gerd and Grompe, Markus and Simas, J. Pedro and Huber, Tobias~B. and Baltimore, David and Gupta, Vineet and Green, Douglas~R. and Ferreira, Jo{\~a}o~A. and Moita, Luis~F.},
 doi = {10.1016/j.immuni.2013.08.039},
 file = {/Users/jkb/Zotero/storage/QMHQ8PA4/Figueiredo et al. - 2013 - Anthracyclines Induce DNA Damage Response-Mediated.pdf;/Users/jkb/Zotero/storage/XTV3XBET/Figueiredo et al. - 2013 - Anthracyclines Induce DNA Damage Response-Mediated.html},
 issn = {1074-7613},
 journal = {Immunity},
 month = {November},
 number = {5},
 pages = {874--884},
 title = {Anthracyclines {{Induce DNA Damage Response-Mediated Protection}} against {{Severe Sepsis}}},
 urldate = {2015-03-12},
 volume = {39},
 year = {2013}
}

