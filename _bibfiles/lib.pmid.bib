@article{gralinskigenomewideidentification2015,
 abstract = {Author Summary   New emerging pathogens are a significant threat to human health with at least six highly pathogenic viruses, including four respiratory viruses, having spread from animal hosts into the human population within the past 15 years. With the emergence of new pathogens, new and better animal models are needed in order to better understand the disease these pathogens cause; to assist in the rapid development of therapeutics; and importantly to evaluate the role of natural host genetic variation in regulating disease outcome. We used incipient lines of the Collaborative Cross, a newly available recombinant inbred mouse panel, to identify polymorphic host genes that contribute to SARS-CoV pathogenesis. We discovered new animal models that better capture the range of disease found in human SARS patients and also found four novel susceptibility loci governing various aspects of SARS-induced pathogenesis. By integrating statistical, genetic and bioinformatic approaches we were able to narrow candidate genome regions to highly likely candidate genes. We narrowed one locus to a single candidate gene,  Trim55 , and confirmed its role in the inflammatory response to SARS-CoV infection through the use of knockout mice. This work identifies a novel function for  Trim55  and also demonstrates the utility of the CC as a platform for identifying the genetic contributions of complex traits.},
 author = {Gralinski, Lisa E. and Ferris, Martin T. and Aylor, David L. and Whitmore, Alan C. and Green, Richard and Frieman, Matthew B. and Deming, Damon and Menachery, Vineet D. and Miller, Darla R. and Buus, Ryan J. and Bell, Timothy A. and Churchill, Gary A. and Threadgill, David W. and Katze, Michael G. and McMillan, Leonard and Valdar, William and Heise, Mark T. and de Villena, Fernando Pardo-Manuel and Baric, Ralph S.},
 doi = {10.1371/journal.pgen.1005504},
 file = {/Users/jkb/Zotero/storage/IMAQBEHH/Gralinski et al. - 2015 - Genome Wide Identification of SARS-CoV Susceptibil.pdf;/Users/jkb/Zotero/storage/WXC2ACCC/Gralinski et al. - 2015 - Genome Wide Identification of SARS-CoV Susceptibil.html},
 issn = {1553-7404},
 journal = {PLOS Genet},
 keyword = {Cloning,Genetic loci,Haplotypes,Inflammation,Mouse models,Quantitative trait loci,Respiratory infections,SARS coronavirus},
 month = {October},
 number = {10},
 pages = {e1005504},
 title = {Genome {{Wide Identification}} of {{SARS-CoV Susceptibility Loci Using}} the {{Collaborative Cross}}},
 urldate = {2016-08-15},
 volume = {11},
 year = {2015}
}

@article{gralinskimolecularpathologyemerging2015,
 abstract = {Respiratory viruses can cause a wide spectrum of pulmonary diseases, ranging from mild, upper respiratory tract infections to severe and life-threatening lower respiratory tract infections, including the development of acute lung injury (ALI) and acute respiratory distress syndrome (ARDS). Viral clearance and subsequent recovery from infection require activation of an effective host immune response; however, many immune effector cells may also cause injury to host tissues. Severe acute respiratory syndrome (SARS) coronavirus and Middle East respiratory syndrome (MERS) coronavirus cause severe infection of the lower respiratory tract, with 10\% and 35\% overall mortality rates, respectively; however, {$>$}50\% mortality rates are seen in the aged and immunosuppressed populations. While these viruses are susceptible to interferon treatment in vitro, they both encode numerous genes that allow for successful evasion of the host immune system until after high virus titres have been achieved. In this review, we discuss the importance of the innate immune response and the development of lung pathology following human coronavirus infection.},
 author = {Gralinski, Lisa E. and Baric, Ralph S.},
 doi = {10.1002/path.4454},
 issn = {1096-9896},
 journal = {The Journal of Pathology},
 keyword = {{Communicable Diseases, Emerging},{Immunity, Innate},{Pathology, Molecular},Animals,Antiviral Agents,Biopsy,coronavirus,Coronavirus Infections,Host-Pathogen Interactions,Humans,Middle East Respiratory Syndrome Coronavirus,Predictive Value of Tests,Respiratory System,Risk Factors,SARS virus,Severe Acute Respiratory Syndrome,Virology,Virulence},
 langid = {english},
 month = {January},
 number = {2},
 pages = {185--195},
 pmcid = {PMC4267971},
 pmid = {25270030},
 title = {Molecular Pathology of Emerging Coronavirus Infections},
 volume = {235},
 year = {2015}
}

@article{grantcircuitsinfectedmacrophages2021,
 abstract = {Some patients infected with severe acute respiratory syndrome coronavirus~2 (SARS-CoV-2) develop severe pneumonia and acute respiratory distress syndrome1 (ARDS). Distinct clinical features in these patients have led to speculation that the immune response to virus in the SARS-CoV-2-infected alveolus differs from that in other types of pneumonia2. Here we investigate SARS-CoV-2 pathobiology by characterizing the immune response in the alveoli of patients infected with the virus. We collected bronchoalveolar lavage fluid samples from 88 patients with SARS-CoV-2-induced respiratory failure and 211 patients with known or suspected pneumonia from other pathogens, and analysed them using flow cytometry and bulk transcriptomic profiling. We performed single-cell RNA sequencing on 10 bronchoalveolar lavage fluid samples collected from patients with severe coronavirus disease 2019 (COVID-19) within 48~h of intubation. In the majority of patients with SARS-CoV-2 infection, the alveolar space was persistently enriched in T cells and monocytes. Bulk and single-cell transcriptomic profiling suggested that SARS-CoV-2 infects alveolar macrophages, which in turn respond by producing T cell chemoattractants. These T cells produce interferon-{$\gamma$} to induce inflammatory cytokine release from alveolar macrophages and further promote T cell activation. Collectively, our results suggest that SARS-CoV-2 causes a slowly unfolding, spatially limited alveolitis in which alveolar macrophages containing SARS-CoV-2 and T cells form a positive feedback loop that drives persistent alveolar inflammation.},
 author = {Grant, Rogan A. and {Morales-Nebreda}, Luisa and Markov, Nikolay S. and Swaminathan, Suchitra and Querrey, Melissa and Guzman, Estefany R. and Abbott, Darryl A. and Donnelly, Helen K. and Donayre, Alvaro and Goldberg, Isaac A. and Klug, Zasu M. and Borkowski, Nicole and Lu, Ziyan and Kihshen, Hermon and Politanska, Yuliya and Sichizya, Lango and Kang, Mengjia and Shilatifard, Ali and Qi, Chao and Lomasney, Jon W. and Argento, A. Christine and Kruser, Jacqueline M. and Malsin, Elizabeth S. and Pickens, Chiagozie O. and Smith, Sean B. and Walter, James M. and Pawlowski, Anna E. and Schneider, Daniel and Nannapaneni, Prasanth and {Abdala-Valencia}, Hiam and Bharat, Ankit and Gottardi, Cara J. and Budinger, G. R. Scott and Misharin, Alexander V. and Singer, Benjamin D. and Wunderink, Richard G.},
 copyright = {2021 The Author(s), under exclusive licence to Springer Nature Limited},
 doi = {10.1038/s41586-020-03148-w},
 file = {/Users/jkb/Zotero/storage/86STIXS7/Grant et al. - 2021 - Circuits between infected macrophages and T cells .pdf;/Users/jkb/Zotero/storage/HZIPMQVX/Grant et al. - 2021 - Circuits between infected macrophages and T cells .html},
 issn = {1476-4687},
 journal = {Nature},
 langid = {english},
 month = {February},
 number = {7847},
