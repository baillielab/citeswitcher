@article{lepoutreepidemiologyinvasivestreptococcus2011,
 abstract = {Invasive group A streptococcal (GAS) infections cause significant morbidity and mortality. A national survey was initiated to assess the burden of invasive GAS infections in France, describe their clinical characteristics, and assess the molecular characteristics of GAS strains responsible for these infections. The survey was conducted in 194 hospitals, accounting for 51\% of acute care hospital admissions in France. Clinical data, predisposing factors, and demographic data were obtained, and all GAS isolates were emm sequence typed. We identified 664 cases of invasive GAS infections, with an annual incidence of 3.1 per 100,000 population. The case-fatality ratio was 14\% and rose to 43\% in the case of streptococcal toxic shock syndrome. Bacteremia without identified focus (22\%) and skin/soft tissue infections (30\%) were the most frequent clinical presentations. Necrotizing fasciitis was frequent in adults (18\%) and uncommon in children (3\%). The 3 predominant emm types were emm1, emm89, and emm28, accounting for 33\%, 16\%, and 10\% of GAS isolates, respectively. The emm1 type was associated with fatal outcomes and was more frequent in children than in adults. Six clusters of cases were identified, with each cluster involving 2 invasive cases due to GAS strains which shared identical GAS emm sequence types. Four clusters of cases involved eight postpartum infections, one family cluster involved a mother and child, and one cluster involved two patients in a nursing home. Invasive GAS infection is one of the most severe bacterial diseases in France, particularly in persons aged {$\geq$} 50 years or when associated with toxic shock syndrome.},
 author = {Lepoutre, A. and Doloy, A. and Bidet, P. and Leblond, A. and Perrocheau, A. and Bingen, E. and {Trieu-Cuot}, P. and Bouvet, A. and Poyart, C. and {L{\'e}vy-Bruhl}, D. and {Microbiologists of the Epibac Network}},
 doi = {10.1128/JCM.00070-11},
 file = {/Users/jkb/Zotero/storage/VITS5U9M/19.html},
 issn = {1098-660X},
 journal = {Journal of Clinical Microbiology},
 keyword = {{Aged, 80 and over},{Antigens, Bacterial},{Child, Preschool},{Fasciitis, Necrotizing},{Infant, Newborn},{Sequence Analysis, DNA},{Shock, Septic},Adolescent,Adult,Aged,Bacteremia,Bacterial Outer Membrane Proteins,Carrier Proteins,Child,Cluster Analysis,Cross-Sectional Studies,Female,France,Genotype,Humans,incidence,Infant,Male,Middle Aged,Molecular Epidemiology,Molecular Typing,Streptococcal Infections,Streptococcus pyogenes,Young Adult},
 langid = {english},
 month = {December},
 number = {12},
 pages = {4094--4100},
 pmcid = {PMC3232948},
 pmid = {21976764},
 title = {Epidemiology of Invasive {{Streptococcus}} Pyogenes Infections in {{France}} in 2007},
