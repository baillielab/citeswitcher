@article{tomasdottirtumornecrosisfactor2003,
 abstract = {Cardiopulmonary bypass induces a systemic inflammatory response characterized by alterations in cardiopulmonary function. Mediators for this morbidity are the cytokines tumor necrosis factor (TNF)-alpha and interleukins. A genomic polymorphism within the TNF locus is associated with increased TNF-alpha levels and high mortality in severe trauma and sepsis. We assessed the relationship of biallelic polymorphisms of the TNF locus in patients undergoing elective cardiac surgery to release of proinflammatory cytokines and cardiopulmonary morbidity. TNF genotypes, plasma concentrations of TNF-alpha, interleukin-6, and cardiopulmonary morbidity were studied in 95 unselected, consecutive patients undergoing routine cardiac surgery. TNF genotypes were determined by the solid-phase minisequencing method. Patients homozygous for the TNFB2 allele (n = 42) displayed larger peak concentrations of TNF-alpha (11.3 +/- 1.3 versus 7.8 +/- 0.7 pg/mL; P = 0.013) and interleukin-6 (153 +/- 27 versus 87 +/- 7 pg/mL; P = 0.010) when compared with patients homozygous or heterozygous for TNFB1 (n = 53). The TNFB2 homozygotes had a higher incidence of left ventricular dysfunction (31\% versus 9\%; P = 0.029; odds ratio 3.84 [95\% confidence interval, 1.40-24.3]), postoperative pulmonary dysfunction (24\% versus 6\%; P = 0.016; odds ratio 5.21 [95\% confidence interval, 1.49-18.3]), and a lower pulmonary oxygenation index (29 +/- 1.9 versus 36.1 +/- 1.8; P = 0.013). Patients homozygous for the TNFB2 allele may develop an enhanced systemic inflammatory response with an increased risk of cardiopulmonary morbidity after cardiac surgery. IMPLICATIONS: The associations between tumor necrosis factor (TNF) gene polymorphism, plasma cytokines, and cardiopulmonary function after elective cardiac surgery were evaluated. Patients homozygous for the TNFB2 allele displayed larger concentrations of TNF-alpha and interleukin-6 and had an increased risk of developing left ventricular and pulmonary dysfunction compared with TNFB1 homo- or heterozygotes},
 author = {Tomasdottir, H. and Hjartarson, H. and Ricksten, A. and Wasslavik, C. and Bengtsson, A. and Ricksten, S.E.},
 journal = {Anesth.Analg.},
 keyword = {{Aged,80 and over},{Anesthesia,General},{Polymorphism,Genetic},{Ventricular Dysfunction,Left},adverse effects,Anesthesia,blood,Cardiac Surgical Procedures,Cardiopulmonary Bypass,chemistry,Cytokines,Dna,DNA Primers,epidemiology,etiology,genetics,Genotype,Heart Diseases,Heterozygote,Homozygote,Incidence,Interleukin-6,Interleukins,Lung Diseases,Lymphotoxin-alpha,metabolism,Morbidity,mortality,Necrosis,Odds Ratio,pathology,Plasma,Postoperative Complications,Research,Reverse Transcriptase Polymerase Chain Reaction,Risk,Sepsis,surgery,Tumor Necrosis Factor,Tumor Necrosis Factor-alpha},
 month = {October},
 number = {4},
 pages = {944--9, table},
 title = {Tumor Necrosis Factor Gene Polymorphism Is Associated with Enhanced Systemic Inflammatory Response and Increased Cardiopulmonary Morbidity after Cardiac Surgery},
 volume = {97},
 year = {2003}
}

@article{tomasonidreamdmitooldisease2019,
 abstract = {{$<$}p{$>$}We define a disease module as a partition of a molecular network that is relevant for disease. Identification of such modules, across different types of networks, is paramount in biomedical research. To this end, we launched the "Disease Module Identification (DMI) DREAM Challenge", a community effort to build and evaluate unsupervised molecular network modularization algorithms. Here we present DreamDMI, a tool leveraging the top methods from the DMI DREAM Challenge; our aim is making those methods easily accessible by the community. DreamDMI is a command line tool for Linux based on Docker and Singulairty containers; the core algorithms were written in R, Python and C++. It is freely available for download at https://github.com/mattiat/DREAM\_DMI\_Tool .{$<$}/p{$>$}},
