 doi = {10.1136/bmjopen-2015-010148},
 file = {/Users/jkb/Zotero/storage/UH7ARTC2/Walsh et al. - 2016 - Rationale, design and methodology of a trial evalu.pdf;/Users/jkb/Zotero/storage/ZLQVY7XV/e010148.html},
