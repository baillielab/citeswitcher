@article{recoverycasirivimabimdevimabpatients2021a,
 abstract = {{$<$}p{$>$}Background: REGEN-COV is a combination of 2 monoclonal antibodies (casirivimab and imdevimab) that bind to two different sites on the receptor binding domain of the SARS-CoV-2 spike protein. We aimed to evaluate the efficacy and safety of REGEN-COV in patients admitted to hospital with COVID-19. Methods: In this randomised, controlled, open-label platform trial, several possible treatments were compared with usual care in patients hospitalised with COVID-19. Eligible and consenting patients were randomly allocated (1:1) to either usual standard of care alone (usual care group) or usual care plus a single dose of REGEN-COV 8g (casirivimab 4g and imdevimab 4g) by intravenous infusion (REGEN-COV group). The primary outcome was 28-day mortality assessed first among patients without detectable antibodies to SARS-CoV-2 at randomisation (seronegative) and then in the overall population. Findings: Between 18 September 2020 and 22 May 2021, 9785 patients were randomly allocated to receive usual care plus REGEN-COV or usual care alone, including 3153 (32\%) seronegative patients, 5272 (54\%) seropositive patients and 1360 (14\%) patients with unknown baseline antibody status. In the primary efficacy population of seronegative patients, 396 (24\%) of 1633 patients allocated to REGEN-COV and 451 (30\%) of 1520 patients allocated to usual care died within 28 days (rate ratio 0.80; 95\% CI 0.70-0.91; p=0.0010). In an analysis involving all randomised patients (regardless of baseline antibody status), 944 (20\%) of 4839 patients allocated to REGEN-COV and 1026 (21\%) of 4946 patients allocated to usual care died within 28 days (rate ratio 0.94; 95\% CI 0.86-1.03; p=0.17). The proportional effect of REGEN-COV on mortality differed significantly between seropositive and seronegative patients (p value for heterogeneity = 0.001). Interpretation: In patients hospitalised with COVID-19, the monoclonal antibody combination of casirivimab and imdevimab (REGEN-COV) reduced 28-day mortality among patients who were seronegative at baseline.{$<$}/p{$>$}},
 author = {RECOVERY and Horby, Peter W. and Mafham, Marion and Peto, Leon and Campbell, Mark and {Pessoa-Amorim}, Guilherme and Spata, Enti and Staplin, Natalie and Emberson, Jonathan R. and Prudon, Benjamin and Hine, Paul and Brown, Thomas and Green, Christopher A. and Sarkar, Rahuldeb and Desai, Purav and Yates, Bryan and Bewick, Tom and Tiberi, Simon and Felton, Tim and Baillie, J. Kenneth and Buch, Maya H. and Chappell, Lucy C. and Day, Jeremy N. and Faust, Saul N. and Jaki, Thomas and Jeffery, Katie and Juszczak, Edmund and Lim, Wei Shen and Montgomery, Alan and Mumford, Andrew and Rowan, Kathryn and Thwaites, Guy and Weinreich, David M. and Haynes, Richard and Landray, Martin J.},
 copyright = {{\copyright} 2021, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution 4.0 International), CC BY 4.0, as described at http://creativecommons.org/licenses/by/4.0/},
 doi = {10.1101/2021.06.15.21258542},
 file = {/Users/jkb/Zotero/storage/7A3AKNP8/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .pdf;/Users/jkb/Zotero/storage/BQBGC8XR/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .pdf;/Users/jkb/Zotero/storage/H7NFZEUW/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .pdf;/Users/jkb/Zotero/storage/TFMQZA23/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .pdf;/Users/jkb/Zotero/storage/2D2PT3XW/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .html;/Users/jkb/Zotero/storage/85B6QDHX/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .html;/Users/jkb/Zotero/storage/SHBQKGSE/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .html;/Users/jkb/Zotero/storage/XIQZFSQ6/Group et al. - 2021 - Casirivimab and imdevimab in patients admitted to .html},
 ids = {groupcasirivimabimdevimabpatients2021a},
