 doi = {10.1038/s41586-022-04802-1},
 issn = {1476-4687},
 journal = {Nature},
 keyword = {Chronic inflammation,Inflammasome,SARS-CoV-2,Viral infection},
 langid = {english},
 month = {June},
 number = {7914},
 pages = {585--593},
 title = {Inflammasome Activation in Infected Macrophages Drives {{COVID-19}} Pathology},
 urldate = {2023-03-11},
