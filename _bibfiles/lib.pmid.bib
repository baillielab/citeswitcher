@article{horowitzgenomewideanalysisprovides2022,
 abstract = {Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) enters human host cells via angiotensin-converting enzyme 2 (ACE2) and causes coronavirus disease 2019 (COVID-19). Here, through a genome-wide association study, we identify a variant (rs190509934, minor allele frequency 0.2--2\%) that downregulates ACE2 expression by 37\% (P\,=\,2.7\,{\texttimes}\,10-8) and reduces the risk of SARS-CoV-2 infection by 40\% (odds ratio\,=\,0.60, P\,=\,4.5\,{\texttimes}\,10-13), providing human genetic evidence that ACE2 expression levels influence COVID-19 risk. We also replicate the associations of six previously reported risk variants, of which four were further associated with worse outcomes in individuals infected with the virus (in/near LZTFL1, MHC, DPP9 and IFNAR2). Lastly, we show that common variants define a risk score that is strongly associated with severe disease among cases and modestly improves the prediction of disease severity relative to demographic and clinical factors alone.},
 author = {Horowitz, Julie E. and Kosmicki, Jack A. and Damask, Amy and Sharma, Deepika and Roberts, Genevieve H. L. and Justice, Anne E. and Banerjee, Nilanjana and Coignet, Marie V. and Yadav, Ashish and Leader, Joseph B. and Marcketta, Anthony and Park, Danny S. and Lanche, Rouel and Maxwell, Evan and Knight, Spencer C. and Bai, Xiaodong and Guturu, Harendra and Sun, Dylan and Baltzell, Asher and Kury, Fabricio S. P. and Backman, Joshua D. and Girshick, Ahna R. and O'Dushlaine, Colm and McCurdy, Shannon R. and Partha, Raghavendran and Mansfield, Adam J. and Turissini, David A. and Li, Alexander H. and Zhang, Miao and Mbatchou, Joelle and Watanabe, Kyoko and Gurski, Lauren and McCarthy, Shane E. and Kang, Hyun M. and Dobbyn, Lee and Stahl, Eli and Verma, Anurag and Sirugo, Giorgio and Ritchie, Marylyn D. and Jones, Marcus and Balasubramanian, Suganthi and Siminovitch, Katherine and Salerno, William J. and Shuldiner, Alan R. and Rader, Daniel J. and Mirshahi, Tooraj and Locke, Adam E. and Marchini, Jonathan and Overton, John D. and Carey, David J. and Habegger, Lukas and Cantor, Michael N. and Rand, Kristin A. and Hong, Eurie L. and Reid, Jeffrey G. and Ball, Catherine A. and Baras, Aris and Abecasis, Gon{\c c}alo R. and Ferreira, Manuel A. R.},
 copyright = {2022 The Author(s)},
 doi = {10.1038/s41588-021-01006-7},
 file = {/Users/jkb/Zotero/storage/8G2UJ2XS/Horowitz et al. - 2022 - Genome-wide analysis provides genetic evidence tha.pdf;/Users/jkb/Zotero/storage/V8X7I75U/Horowitz et al. - 2022 - Genome-wide analysis provides genetic evidence tha.html},
 issn = {1546-1718},
 journal = {Nature Genetics},
 keyword = {Genome-wide association studies,Population genetics},
 langid = {english},
 month = {March},
 pages = {1--11},
 title = {Genome-Wide Analysis Provides Genetic Evidence That {{ACE2}} Influences {{COVID-19}} Risk and Yields Risk Scores Associated with Severe Disease},
