 pmid = {27525044},
 shorttitle = {Restricting Retrotransposons},
 title = {Restricting Retrotransposons: A Review},
 urldate = {2018-10-22},
 volume = {7},
 year = {2016}
}

@article{goodierretrotransposonsrevisitedrestraint2008,
 abstract = {Retrotransposons, mainly LINEs, SINEs, and endogenous retroviruses, make up roughly 40\% of the mammalian genome and have played an important role in genome evolution. Their prevalence in genomes reflects a delicate balance between their further expansion and the restraint imposed by the host. In any human genome only a small number of LINE1s (L1s) are active, moving their own and SINE sequences into new genomic locations and occasionally causing disease. Recent insights and new technologies promise answers to fundamental questions about the biology of transposable elements.},
 author = {Goodier, John L. and Kazazian Jr., Haig H.},
