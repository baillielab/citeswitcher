@article{mosconaglobaltransmissionoseltamivirresistant2009,
 abstract = {Seemingly from one influenza season to the next, we have lost the use of our leading antiviral influenza drug because of resistance. This winter, the circulating strain of seasonal influenza A virus (H1N1) is resistant to the neuraminidase inhibitor oseltamivir. Moreover, rather than emerging under selective pressure of drug use, as many antibiotic-resistant bacteria do and as has been the concern for influenza, this resistant strain seems to be a natural, spontaneously arising variant. Nevertheless, science has given us the tools with which to anticipate these events --- and should allow us to develop new clinical solutions that build on . . .},
 author = {Moscona, Anne},
 doi = {10.1056/NEJMp0900648},
 file = {/Users/jkb/Zotero/storage/GJXF7TGC/Moscona - 2009 - Global Transmission of Oseltamivir-Resistant Influ.pdf;/Users/jkb/Zotero/storage/RCB67VE3/NEJMp0900648.html},
 issn = {0028-4793},
