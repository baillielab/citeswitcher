 keyword = {{Adaptation, Physiological},{Evolution, Molecular},{Hemagglutinin Glycoproteins, Influenza Virus},{Influenza A Virus, H5N1 Subtype},{Influenza, Human},{Models, Biological},{Receptors, Virus},{Selection, Genetic},Air Microbiology,Amino Acid Substitution,Animals,Birds,Genetic Fitness,glycosylation,High-Throughput Nucleotide Sequencing,Humans,Influenza in Birds,Mammals,Mutation,Orthomyxoviridae Infections,Probability,Respiratory System,RNA Replicase,Sialic Acids,Viral Proteins},
 langid = {english},
