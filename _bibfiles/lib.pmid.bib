 issn = {0028-0836},
 journal = {Nature},
 keyword = {{Antigens, Protozoan},{Antigens, Surface},{Cells, Cultured},Animals,CD36 Antigens,Cell Adhesion,Cell Differentiation,Dendritic Cells,Erythrocytes,Humans,Immune Tolerance,Lymphocyte Activation,Plasmodium falciparum,Protozoan Proteins,T-Lymphocytes,Thrombospondins},
 langid = {english},
 month = {July},
 number = {6739},
 pages = {73--77},
 pmid = {10403251},
 title = {Plasmodium Falciparum-Infected Erythrocytes Modulate the Maturation of Dendritic Cells},
 volume = {400},
 year = {1999}
}

