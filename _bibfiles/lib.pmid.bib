 issn = {0027-8424, 1091-6490},
 journal = {Proceedings of the National Academy of Sciences},
 keyword = {Functional genomics,HCV,RNA interference,viral host factors,viral lifecycle},
 langid = {english},
 month = {September},
 number = {38},
 pages = {16410--16415},
 pmid = {19717417},
 title = {A Genome-Wide Genetic Screen for Host Factors Required for Hepatitis {{C}} Virus Propagation},
