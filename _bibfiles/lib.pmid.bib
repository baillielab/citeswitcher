 shorttitle = {Nonlinear {{Imputation}} of {{PaO2}}/{{FIO2 From SpO2}}/{{FIO2 Among Mechanically Ventilated Patients}} in the {{ICU}}},
 title = {Nonlinear {{Imputation}} of {{PaO2}}/{{FIO2 From SpO2}}/{{FIO2 Among Mechanically Ventilated Patients}} in the {{ICU}}: {{A Prospective}}, {{Observational Study}}},
