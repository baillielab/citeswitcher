 journal = {arXiv:2012.08836 [physics]},
 keyword = {Physics - Biological Physics,Physics - Optics},
 month = {December},
 primaryclass = {physics},
 title = {Sub Millimetre Flexible Fibre Probe for Background and Fluorescence Free {{Raman}} Spectroscopy},
 urldate = {2021-02-10},
