 keyword = {apoptosis,Cancer,Cell Death,cell growth,CR,differentiation,Immunology,neurodegeneration},
 langid = {english},
 number = {7},
 pages = {1129--1139},
 title = {Phospholipid {{Scramblase}} 1 Regulates {{Toll-like}} Receptor 9-Mediated Type {{I}} Interferon Production in Plasmacytoid Dendritic Cells},
 urldate = {2012-07-08},
