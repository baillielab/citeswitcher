 abstract = {Biologists have long sought to understand which genes and what kinds of changes in their sequences are responsible for the evolution of morphological diversity. Here, I outline eight principles derived from molecular and evolutionary developmental biology and review recent studies of species divergence that have led to a genetic theory of morphological evolution, which states that (1) form evolves largely by altering the expression of functionally conserved proteins, and (2) such changes largely occur through mutations in the cis-regulatory sequences of pleiotropic developmental regulatory loci and of the target genes within the vast networks they control.},
 author = {Carroll, Sean B.},
 doi = {10.1016/j.cell.2008.06.030},
