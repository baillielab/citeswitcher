 pages = {155--180},
 shorttitle = {Social Uncertainty and Interdependence},
 title = {Social Uncertainty and Interdependence: {{A}} Study of Resource Allocation Decisions in Groups},
 urldate = {2012-05-09},
 volume = {46},
 year = {1990}
}

