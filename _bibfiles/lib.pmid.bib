 doi = {10/ggmx4d},
 file = {/Users/jkb/Zotero/storage/RQUZZ9QG/Xu et al. - 2020 - Clinical findings in a group of patients infected .pdf;/Users/jkb/Zotero/storage/83BH4GBQ/bmj.html},
