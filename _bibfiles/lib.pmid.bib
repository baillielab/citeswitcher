 number = {6142},
 pages = {186--191},
 pmid = {23846901},
 title = {Mg2+ {{Regulates Cytotoxic Functions}} of {{NK}} and {{CD8 T Cells}} in {{Chronic EBV Infection Through NKG2D}}},
 urldate = {2013-12-29},
