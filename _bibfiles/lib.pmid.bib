 file = {/Users/jkb/Zotero/storage/ABBQCP5T/Huh_PRX3_knockout.pdf},
 issn = {1557-7716},
 journal = {Antioxidants \& Redox Signaling},
 keyword = {{Adipose Tissue, White},{Cells, Cultured},{Mice, Knockout},Adipocytes,Adipogenesis,Adipokines,Adiposity,Animals,Blood Glucose,Cell Enlargement,gene expression,Gene expression,Gene Expression Profiling,Gene Expression Regulation,Homeodomain Proteins,Lipid Metabolism,Male,Mice,Mitochondria,Mitochondrial Proteins,Oxidative stress,Peroxiredoxin III,Peroxiredoxins},
