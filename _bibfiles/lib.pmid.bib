 doi = {10.1096/fj.05-5360com},
 file = {/Users/jkb/Zotero/storage/ZMG2V4NZ/Aung et al. - 2006 - LPS regulates proinflammatory gene expression in m.pdf;/Users/jkb/Zotero/storage/FGNJ3RH8/1315.html},
 journal = {FASEB J.},
 month = {July},
 number = {9},
 pages = {1315--1327},
 title = {{{LPS}} Regulates Proinflammatory Gene Expression in Macrophages by Altering Histone Deacetylase Expression},
