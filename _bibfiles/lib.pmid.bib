 doi = {10.1136/gutjnl-2020-320953},
 file = {/Users/jkb/Zotero/storage/D8BM8JJX/Zhang et al. - 2020 - Digestive system is a potential route of COVID-19.pdf;/Users/jkb/Zotero/storage/V3CICMJC/1010.html},
 issn = {0017-5749, 1468-3288},
 journal = {Gut},
 keyword = {infectious disease,medical decision analysis,receptor binding},
 langid = {english},
 month = {June},
 number = {6},
