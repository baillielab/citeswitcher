 issn = {0006-291X},
 journal = {Biochemical and Biophysical Research Communications},
 keyword = {Lung inflammation,MER5 (peroxiredoxin III),Oxidative stress,Peroxiredoxin,Reactive oxygen species (ROS)},
 month = {April},
