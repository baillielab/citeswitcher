@article{horbyupdatedsystematicreview2013,
 abstract = {The World Health Organization has identified studies of the role of host genetics on susceptibility to severe influenza as a priority. A systematic review was conducted in June 2011 to summarise the evidence on the role of host genetics in susceptibility to influenza, and this report updates that previously published review. Animal studies suggest that genetic control of susceptibility to severe influenza in mice is complex and not controlled by a single locus, but there is encouraging evidence that some of the host genetic determinants of susceptibility to severe disease may be common across influenza subtypes. Although a number of studies on genetic susceptibility to influenza in humans have been published recently, all are underpowered and unreplicated, so do not provide robust statistical evidence of an association between the identified genetic loci and susceptibility. One study does however present convincing functional evidence for an important role for IFITM3 in susceptibility to severe influenza in mice, and some evidence that this may also be important in human A/H1N1/pdm2009 infection.},
 author = {Horby, Peter and Nguyen, Nhu Y. and Dunstan, Sarah J. and Baillie, J. Kenneth},
 doi = {10.1111/irv.12079},
 file = {/Users/jkb/Zotero/storage/LSJE2PZU/Horby et al. - 2013 - An updated systematic review of the role of host g.pdf;/Users/jkb/Zotero/storage/Z5B9A77X/Horby et al. - 2013 - An updated systematic review of the role of host g.pdf;/Users/jkb/Zotero/storage/76WEZNYC/irv.html;/Users/jkb/Zotero/storage/H5QJ45XN/abstract.html},
 ids = {horbyUpdatedSystematicReview2013a},
 issn = {1750-2659},
 journal = {Influenza and Other Respiratory Viruses},
 keyword = {animal model,Animal model,host genetics,human influenza,susceptibility,systematic review},
 langid = {english},
 month = {September},
 pages = {37--41},
 title = {An Updated Systematic Review of the Role of Host Genetics in Susceptibility to Influenza},
 urldate = {2016-11-10},
 volume = {7},
 year = {2013}
}

