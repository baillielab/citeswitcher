@article{sahaestimatingattributablefraction2023,
 abstract = {{$<$}h3{$>$}Background{$<$}/h3{$>$} {$<$}p{$>$}Efficiency of randomised clinical trials of acute respiratory distress syndrome (ARDS) depends on the fraction of deaths attributable to ARDS (AF\textsubscript{ARDS}) to which interventions are targeted. Estimates of AF\textsubscript{ARDS} in subpopulations of ARDS could improve design of ARDS trials.{$<$}/p{$><$}h3{$>$}Methods{$<$}/h3{$>$} {$<$}p{$>$}We performed a matched case-control study using the Large observational study to UNderstand the Global impact of Severe Acute respiratory FailurE cohort. Primary outcome was intensive care unit mortality. We used nearest neighbour propensity score matching without replacement to match ARDS to non-ARDS populations. We derived two separate AF\textsubscript{ARDS} estimates by matching patients with ARDS to patients with non-acute hypoxaemic respiratory failure (non-AHRF) and to patients with AHRF with unilateral infiltrates only (AHRF-UL). We also estimated AF\textsubscript{ARDS} in subgroups based on severity of hypoxaemia, number of lung quadrants involved and hyperinflammatory versus hypoinflammatory phenotypes. Additionally, we derived AF\textsubscript{AHRF} estimates by matching patients with AHRF to non-AHRF controls, and AF\textsubscript{AHRF-UL} estimates by matching patients with AHRF-UL to non-AHRF controls.{$<$}/p{$><$}h3{$>$}Results{$<$}/h3{$>$} {$<$}p{$>$}Estimated AF\textsubscript{ARDS} was 20.9\% (95\% CI 10.5\% to 31.4\%) when compared with AHRF-UL controls and 38.0\% (95\% CI 34.4\% to 41.6\%) compared with non-AHRF controls. Within subgroups, estimates for AF\textsubscript{ARDS} compared with AHRF-UL controls were highest in patients with severe hypoxaemia (41.1\% (95\% CI 25.2\% to 57.1\%)), in those with four quadrant involvement on chest radiography (28.9\% (95\% CI 13.4\% to 44.3\%)) and in the hyperinflammatory subphenotype (26.8\% (95\% CI 6.9\% to 46.7\%)). Estimated AF\textsubscript{AHRF} was 33.8\% (95\% CI 30.5\% to 37.1\%) compared with non-AHRF controls. Estimated AF\textsubscript{AHRF-UL} was 21.3\% (95\% CI 312.8\% to 29.7\%) compared with non-AHRF controls.{$<$}/p{$><$}h3{$>$}Conclusions{$<$}/h3{$>$} {$<$}p{$>$}Overall AF\textsubscript{ARDS} mean values were between 20.9\% and 38.0\%, with higher AF\textsubscript{ARDS} seen with severe hypoxaemia, four quadrant involvement on chest radiography and hyperinflammatory ARDS.{$<$}/p{$>$}},
 author = {Saha, Rohit and Pham, T{\`a}i and Sinha, Pratik and Maddali, Manoj V. and Bellani, Giacomo and Fan, Eddy and Summers, Charlotte and Douiri, Abdel and Rubenfeld, Gordon D. and Calfee, Carolyn S. and Laffey, John Gerard and McAuley, Daniel Francis and {Shankar-Hari}, Manu},
 copyright = {{\copyright} Author(s) (or their employer(s)) 2023. No commercial re-use. See rights and permissions. Published by BMJ.},
 doi = {10.1136/thorax-2023-220262},
 issn = {0040-6376, 1468-3296},
 journal = {Thorax},
 langid = {english},
 month = {July},
 pmid = {37495364},
 title = {Estimating the Attributable Fraction of Mortality from Acute Respiratory Distress Syndrome to Inform Enrichment in Future Randomised Clinical Trials},
 urldate = {2023-08-02},
 year = {2023}
}

@article{sahuphospholipidscramblasesoverview2007,
 abstract = {Phospholipid scramblases are a group of homologous proteins that are conserved in all eukaryotic organisms. They are believed to be involved in destroying plasma membrane phospholipid asymmetry at critical cellular events like cell activation, injury and apoptosis. However, a detailed mechanism of phospholipid scrambling still awaits a proper understanding. The most studied member of this family, phospholipid scramblase 1 (PLSCR1) (a 37kDa protein), is involved in rapid Ca2+ dependent transbilayer redistribution of plasma membrane phospholipids. Recently the function of PLSCR1 as a phospholipids translocator has been challenged and evidences suggest that PLSCR1 acts as signaling molecule. It has been shown to be involved in protein phosphorylation and as a potential activator of genes in response to interferon and other cytokines. Interferon induced rapid biosynthesis of PLSCR1 targets some of the protein into the nucleus, where it binds to the promoter region of inositol 1,4,5-triphosphate (IP3) receptor type 1 (IP3R1) gene and induces its expression. Palmitoylation of PLSCR1 acts as a switch, controlling its localization either to the PM or inside the nucleus. In the present review, we discuss the current understanding of PLSCR1 in relation to its trafficking, localization and signaling functions.},
 author = {Sahu, Santosh Kumar and Gummadi, Sathyanarayana N. and Manoj, N. and Aradhyam, Gopala Krishna},
 doi = {10.1016/j.abb.2007.04.002},
 issn = {0003-9861},
 journal = {Archives of Biochemistry and Biophysics},
 keyword = {Nuclear localization signal,Palmitoylation,Phospholipid translocation,Raft,Scramblase},
 langid = {english},
 month = {June},
 number = {1},
 pages = {103--114},
 shorttitle = {Phospholipid Scramblases},
 title = {Phospholipid Scramblases: {{An}} Overview},
 urldate = {2021-08-30},
 volume = {462},
 year = {2007}
}

@article{sairtissueoxygenationperfusion1996,
 abstract = {Sepsis is believed to induce disturbances in microcirculatory flow and nutrient exchange, which may result in impaired tissue oxygenation. With the use of an established rat model of endotoxemia, voltametric measurements were made of skeletal muscle (tissue) oxygen tension (PtO2) and its response to inspired oxygen concentration (FIO2). Steady-state nutritive flow and the response of endotoxemic muscle to ischemia-reperfusion were also measured. In the presence of a normal arterial PO2, mean muscle PtO2 in the endotoxemic group was significantly lower than controls (52 +/- 9 vs. 24 +/- 4 Torr, P {$<$} 0.01; +/- SE). Endotoxemic muscle PtO2 values showed less heterogeneity than control groups and significant attenuation of the response to increasing FIO2 to 0.95 (mean rise in PtO2 +/- SE; 27 +/- 7 vs. 80 +/- 11 Torr for endotoxemic and control groups, respectively; P {$<$} 0.01). No steady-state differences in tissue perfusion or response to ligation-induced ischemia-reperfusion could be demonstrated between endotoxemic and control rats. These data suggest that there is significant tissue hypoxia and abnormal microvascular control of oxygenation in endotoxemia, even in the presence of normal microcirculatory perfusion},
 author = {Sair, M. and Etherington, P.J. and Curzen, N.P. and Winlove, C.P. and Evans, T.W.},
 journal = {Am J Physiol},
 keyword = {{Muscle,Skeletal},{Rats,Wistar},blood,Blood Circulation,Blood Pressure,Critical Care,Endotoxemia,Heart,Lung,metabolism,Microcirculation,Perfusion,physiopathology,Rats,Research,Sepsis},
 month = {October},
 number = {4 Pt 2},
 pages = {H1620-H1625},
 title = {Tissue Oxygenation and Perfusion in Endotoxemia},
 volume = {271},
 year = {1996}
}

