 issn = {0959-8138, 1756-1833},
 journal = {BMJ},
 langid = {english},
 month = {May},
 pages = {j1909},
 pmid = {28487435},
 shorttitle = {Risk of Acute Myocardial Infarction with {{NSAIDs}} in Real World Use},
 title = {Risk of Acute Myocardial Infarction with {{NSAIDs}} in Real World Use: Bayesian Meta-Analysis of Individual Patient Data},
 urldate = {2019-01-14},
 volume = {357},
 year = {2017}
}

