 issn = {1615-9861},
 journal = {PROTEOMICS},
 keyword = {Bioinformatics,Human,Microbiology,Stable isotope labelling,Western blot analysis},
 langid = {english},
 month = {May},
 number = {9},
 pages = {1431--1436},
 title = {A Quantitative Proteomic Analysis of Lung Epithelial ({{A549}}) Cells Infected with 2009 Pandemic Influenza {{A}} Virus Using Stable Isotope Labelling with Amino Acids in Cell Culture},
 urldate = {2015-04-16},
