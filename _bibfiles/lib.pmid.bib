 issn = {1553-7374},
 journal = {PLOS Pathog},
 keyword = {Alleles,Genetic polymorphism,Genetics of disease,Inflammatory diseases,Influenza,Influenza A virus,Population genetics,Quantitative trait loci},
 month = {February},
 number = {2},
 pages = {e1003196},
 title = {Modeling {{Host Genetic Regulation}} of {{Influenza Pathogenesis}} in the {{Collaborative Cross}}},
 urldate = {2016-10-20},
 volume = {9},
