@article{gamblereassessmentmercurysilastic1993,
 abstract = {1. We have used non-invasive mercury in a silastic strain gauge system to assess the effect of pressure step size, on the time course of the rapid volume response (RVR) to occlusion pressure. We also obtained values for hydraulic conductance (Kf), isovolumetric venous pressure (Pvi) and venous pressure (Pv) in thirty-five studies on the legs of twenty-three supine control subjects. 2. The initial rapid volume response to small (9.53 +/- 0.45 mmHg, mean +/- S.E.M.) stepped increases in venous pressure, the rapid volume response, could be described by a single exponential of time constant 15.54 +/- 1.14 s. 3. Increasing the size of the pressure step, to 49.8 +/- 1.1 mmHg, gave a larger value for the RVR time constant (mean 77.3 +/- 11.6 s). 4. We propose that the pressure-dependent difference in the duration of the rapid volume response, in these two situations, might be due to a vascular smooth muscle-based mechanism, e.g. the veni-arteriolar reflex. 5. The mean (+/- S.E.M.) values for Kf, Pvi and Pv were 4.27 +/- 0.18 (units, ml min-1 (100 g)-1 mmHg-1 x 10(-3), 21.50 +/- 0.81 (units, mmHg) and 9.11 +/- 0.94 (units, mmHg), respectively. 6. During simultaneous assessment of these parameters in arms and legs, it was found that they did not differ significantly from one another. 7. We propose that the mercury strain gauge system offers a useful, non-invasive means of studying the mechanisms governing fluid filtration in human limbs.},
 author = {Gamble, J and Gartside, I B and Christ, F},
 issn = {0022-3751},
 journal = {The Journal of Physiology},
 keyword = {Arm,Blood Vessels,Capillary Permeability,Compliance,Equipment Design,Humans,Leg,Mercury,Microcirculation,Plethysmography,Polymers,Pressure,Silicones,Time Factors,Venous Pressure},
 month = {May},
 pages = {407--422},
 pmid = {8229810},
 title = {A Reassessment of Mercury in Silastic Strain Gauge Plethysmography for Microvascular Permeability Assessment in Man},
 urldate = {2010-11-18},
 volume = {464},
 year = {1993}
}

