 keyword = {{Drug Therapy, Combination},{Pulse Therapy, Drug},Adult,Aged,Anti-Inflammatory Agents,Antiviral Agents,Convalescence,Female,Humans,Male,Methylprednisolone,Middle Aged,Plasma,Retrospective Studies,Ribavirin,SARS virus,Severe Acute Respiratory Syndrome,Treatment Outcome},
 langid = {english},
