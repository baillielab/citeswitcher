 issn = {1530-0293},
 journal = {Critical Care Medicine},
 keyword = {{Models, Theoretical},{Receptors, Cell Surface},Adult,African Continental Ancestry Group,Chemokines,Cytokines,Duffy Blood-Group System,Endotoxemia,European Continental Ancestry Group,Humans,Inflammation,Leukocyte Count,Male,Prospective Studies},
 month = {January},
 number = {1},
