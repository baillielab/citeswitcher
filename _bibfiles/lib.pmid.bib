 issn = {0027-8424, 1091-6490},
 journal = {Proceedings of the National Academy of Sciences},
 keyword = {cell reprogramming,differentiation plasticity,hematopoiesis},
 langid = {english},
 month = {April},
 number = {16},
 pages = {6057--6062},
 title = {{{PU}}.1 and {{C}}/{{EBP$\alpha$}}/{$\beta$} Convert Fibroblasts into Macrophage-like Cells},
 urldate = {2012-07-21},
