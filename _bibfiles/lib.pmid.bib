@article{levinfamilialdisseminatedatypical1995,
 abstract = {Inherited defects in specific components of the immune system have provided many clues to the immunological mechanisms underlying resistance to microbial infection. We report a familial immune defect predisposing to disseminated atypical mycobacterial infection in childhood. 6 children with disseminated atypical mycobacterial infection and no recognised form of immunodeficency were identified. Four, including two brothers, come from a village in Malta, and two are brothers of Greek Cypriot origin. They presented with fever, weight loss, lymphadenopathy, and hepatosplenomegaly. They had anaemia and an acute phase response. A range of different mycobacteria (Mycobacterium fortuitum, M chelonei, and four strains of M avium intracellulare complex) were isolated. Treatment with multiple antibiotics failed to eradicate the infection, although treatment with gamma interferon was associated with improvement. Three have died and the surviving children have chronic infection. Tumour necrosis factor-alpha production in response to endotoxin and gamma-interferon was found to be defective in affected patients and their parents. T-cell proliferative responses to mycobacterial and recall antigens were reduced in parents of affected children and gamma-interferon production was diminished in the affected patients and their parents. Clinical and immunological features suggest that these patients are phenotypically similar to Lsh/Ity/Bcg susceptible mice. Understanding of this defect may provide insights into the mechanisms responsible for susceptibility to mycobacteria.},
 author = {Levin, M and Newport, M J and D'Souza, S and Kalabalikis, P and Brown, I N and Lenicker, H M and Agius, P V and Davies, E G and Thrasher, A and Klein, N},
 issn = {0140-6736},
 journal = {Lancet},
 keyword = {{Antigens, Bacterial},{Child, Preschool},{Mycobacteria, Atypical},{Mycobacterium Infections, Atypical},Adult,Child,Chronic Disease,Endotoxins,Female,Genetic Predisposition to Disease,Humans,Infant,Interferon-gamma,Lymphocyte Activation,Male,Pedigree,Tumor Necrosis Factor-alpha},
 month = {January},
 number = {8942},
 pages = {79--83},
 pmid = {7815885},
 shorttitle = {Familial Disseminated Atypical Mycobacterial Infection in Childhood},
 title = {Familial Disseminated Atypical Mycobacterial Infection in Childhood: A Human Mycobacterial Susceptibility Gene?},
 urldate = {2010-05-14},
 volume = {345},
 year = {1995}
