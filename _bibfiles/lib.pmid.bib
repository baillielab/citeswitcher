@article{martinogenomeselfcomplementaryadenoassociated2011,
 abstract = {Abstract             Although adeno-associated viral (AAV) vectors have been successfully used in hepatic gene transfer for treatment of hemophilia and other diseases in animals, adaptive immune responses blocked long-term transgene expression in patients on administration of single-stranded AAV serotype-2 vector. More efficient vectors have been developed using alternate capsids and self-complimentary (sc) genomes. This study investigated their effects on the innate immune profile on hepatic gene transfer to mice. A mild and transient up-regulation of myeloid differentiation primary response gene (88), TLR9, TNF-{$\alpha$}, monocyte chemotactic protein-1, IFN-{$\gamma$} inducible protein-10, and IFN-{$\alpha$}/{$\beta$} expression in the liver was found after single-stranded AAV vector administration, regardless of the capsid sequence. In contrast, scAAV vectors induced higher increases of these transcripts, upregulated additional proinflammatory genes, and increased circulating IL-6. Neutrophil, macrophage, and natural killer cell liver infiltrates were substantially higher on injection of scAAV. Some but not all of these responses were Kupffer cell dependent. Independent of the capsid or expression cassette, scAAV vectors induced dose-dependent innate responses by signaling through TLR9. Increased innate responses to scAAV correlated with stronger adaptive immune responses against capsid (but not against the transgene product). However, these could be blunted by transient inhibition of TLR9.},
 author = {Martino, Ashley T. and Suzuki, Masataka and Markusic, David M. and Zolotukhin, Irene and Ryals, Renee C. and Moghimi, Babak and Ertl, Hildegund C. J. and Muruve, Daniel A. and Lee, Brendan and Herzog, Roland W.},
 doi = {10.1182/blood-2010-10-314518},
 issn = {0006-4971, 1528-0020},
 journal = {Blood},
 langid = {english},
 month = {June},
 number = {24},
 pages = {6459--6468},
 title = {The Genome of Self-Complementary Adeno-Associated Viral Vectors Increases {{Toll-like}} Receptor 9--Dependent Innate Immune Responses in the Liver},
 urldate = {2022-05-18},
 volume = {117},
 year = {2011}
}

@article{marwaethicalanalyticchallenges2021,
 abstract = {The implementation of precision medicine and next-generation sequencing technologies in the field of oncology is a novel approach being more widely studied and used in cases of high-risk primary and recurrent malignancies. Leukemias are the second most common cause of cancer-related mortality in children and the sixth most in adults. Relapsed leukemia represents a major component of the population that may benefit from genomic sequencing. However, ethical and analytic challenges arise when considering sequencing of biologic samples obtained from patients with relapsed leukemia following allogeneic hematopoietic stem-cell transplantation. Blood from the recipient after transplantation would include donor-derived cells and thus, genomic sequencing of recipient blood will interrogate the donor germline in addition to the somatic genetic profile of the leukemia cells and the recipient germline. This is a situation for which the donor will not have typically provided consent and may be particularly problematic if actionable secondary or incidental findings related to the donor are uncovered. We present the challenges raised in this scenario and provide strategies to mitigate this risk.},
 author = {Marwa, Bilal and Krueger, Joerg and Stephenson, Elizabeth A. and Davidson, Scott and Allan, David and Knoppers, Bartha and Zawati, Ma'n and Sullivan, Patrick and Shlien, Adam and Malkin, David and Fernandez, Conrad V. and Villani, Anita},
 doi = {10.1200/PO.20.00489},
 journal = {JCO Precision Oncology},
 month = {December},
 number = {5},
 pages = {1339--1347},
 title = {Ethical and {{Analytic Challenges With Genomic Sequencing}} of {{Relapsed Hematologic Malignancies Following Allogeneic Hematopoietic Stem-Cell Transplantation}}},
 urldate = {2024-01-23},
 year = {2021}
}

@article{marzluffhumanmousereplicationdependent2002,
 abstract = {The multigene family encoding the five classes of replication-dependent histones has been identified from the human and mouse genome sequence. The large cluster of histone genes, HIST1, on human chromosome 6 (6p21--p22) contains 55 histone genes, and Hist1 on mouse chromosome 13 contains 51 histone genes. There are two smaller clusters on human chromosome 1: HIST2 (at 1q21), which contains six genes, and HIST3 (at 1q42), which contains three histone genes. Orthologous Hist2 and Hist3 clusters are present on mouse chromosomes 3 and 11, respectively. The organization of the human and mouse histone genes in the HIST1 cluster is essentially identical. All of the histone H1 genes are in HIST1, which is spread over about 2 Mb. There are two large gaps (\&gt;250 kb each) within this cluster where there are no histone genes, but many other genes. Each of the histone genes encodes an mRNA that ends in a stemloop followed by a purine-rich region that is complementary to the 5{$\prime$} end of U7 snRNA. In addition to the histone genes on these clusters, only two other genes containing the stem-loop sequence were identified, a histone H4 gene on human chromosome 12 (mouse chromosome 6) and the previously described H2a.X gene located on human chromosome 11. Each of the 14 histone H4 genes encodes the same protein, and there are only three histone H3 proteins encoded by the 12 histone H3 genes in each species. In contrast, both the mouse and human H2a and H2b proteins consist of at least 10 non-allelic variants, making the complexity of the histone protein complement significantly greater than previously thought.},
 author = {Marzluff, William F. and Gongidi, Preetam and Woods, Keith R. and Jin, Jianping and Maltais, Lois J.},
 doi = {10.1006/geno.2002.6850},
 file = {/Users/jkb/Zotero/storage/UNHB6GTZ/Marzluff et al. - 2002 - The Human and Mouse Replication-Dependent Histone .pdf;/Users/jkb/Zotero/storage/MQ4MV2GG/Marzluff et al. - 2002 - The Human and Mouse Replication-Dependent Histone .html},
 issn = {0888-7543},
 journal = {Genomics},
 month = {November},
 number = {5},
 pages = {487--498},
 title = {The {{Human}} and {{Mouse Replication-Dependent Histone Genes}}},
 urldate = {2012-07-06},
 volume = {80},
 year = {2002}
}

@article{mascheroniacuterespiratoryfailure1988,
 abstract = {The pulmonary effects of hyperventilation following infusion of sodium salicylate into the cisterna magna was studied in 16 spontaneously breathing adult sheep. We found a fall in PaO2, a decrease in the static compliance of the respiratory system, abnormal chest roentgenographic films, and grossly abnormal lungs following 3.5 to 13 h of hyperventilation. A control group of 15 sheep (10 sheep similarly injected with sodium salicylate, but then sedated and paralyzed and ventilated at normal tidal volume and respiratory rate on a mechanical ventilator, and 5 sheep infused with saline alone and breathing spontaneously) showed no pulmonary or arterial blood gas abnormalities. We conclude that prolonged hyperventilation under the conditions of this experiment precipitated events that resulted in acute lung injury.},
 author = {Mascheroni, D. and Kolobow, T. and Fumagalli, R. and Moretti, M. P. and Chen, V. and Buckhold, D.},
 issn = {0342-4642},
 journal = {Intensive Care Medicine},
 keyword = {{Respiration, Artificial},Animals,Hyperventilation,Lung Volume Measurements,Respiratory Insufficiency,Sheep,Sodium Salicylate},
 langid = {english},
 number = {1},
 pages = {8--14},
 pmid = {3230208},
 shorttitle = {Acute Respiratory Failure Following Pharmacologically Induced Hyperventilation},
 title = {Acute Respiratory Failure Following Pharmacologically Induced Hyperventilation: An Experimental Animal Study},
 volume = {15},
 year = {1988}
}

@article{masloveredefiningcriticalillness2022,
 abstract = {Research and practice in critical care medicine have long been defined by syndromes, which, despite being clinically recognizable entities, are, in fact, loose amalgams of heterogeneous states that may respond differently to therapy. Mounting translational evidence---supported by research on respiratory failure due to severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection---suggests that the current syndrome-based framework of critical illness should be reconsidered. Here we discuss recent findings from basic science and clinical research in critical care and explore how these might inform a new conceptual model of critical illness. De-emphasizing syndromes, we focus on the underlying biological changes that underpin critical illness states and that may be amenable to treatment. We hypothesize that such an approach will accelerate critical care research, leading to a richer understanding of the pathobiology of critical illness and of the key determinants of patient outcomes. This, in turn, will support the design of more effective clinical trials and inform a more precise and more effective practice at the bedside.},
 author = {Maslove, David M. and Tang, Benjamin and {Shankar-Hari}, Manu and Lawler, Patrick R. and Angus, Derek C. and Baillie, J. Kenneth and Baron, Rebecca M. and Bauer, Michael and Buchman, Timothy G. and Calfee, Carolyn S. and {dos Santos}, Claudia C. and {Giamarellos-Bourboulis}, Evangelos J. and Gordon, Anthony C. and Kellum, John A. and Knight, Julian C. and Leligdowicz, Aleksandra and McAuley, Daniel F. and McLean, Anthony S. and Menon, David K. and Meyer, Nuala J. and Moldawer, Lyle L. and Reddy, Kiran and Reilly, John P. and Russell, James A. and Sevransky, Jonathan E. and Seymour, Christopher W. and Shapiro, Nathan I. and Singer, Mervyn and Summers, Charlotte and Sweeney, Timothy E. and Thompson, B. Taylor and {van der Poll}, Tom and Venkatesh, Balasubramanian and Walley, Keith R. and Walsh, Timothy S. and Ware, Lorraine B. and Wong, Hector R. and Zador, Zsolt E. and Marshall, John C.},
 copyright = {2022 Springer Nature America, Inc.},
 doi = {10.1038/s41591-022-01843-x},
 file = {/Users/jkb/Zotero/storage/IH36HDJU/Maslove et al. - 2022 - Redefining critical illness.pdf;/Users/jkb/Zotero/storage/JVKI286I/s41591-022-01843-x.html},
 issn = {1546-170X},
 journal = {Nature Medicine},
 keyword = {Laboratory techniques and procedures,Therapeutics,Translational research},
 langid = {english},
 month = {June},
 number = {6},
 pages = {1141--1148},
 publisher = {Nature Publishing Group},
 title = {Redefining Critical Illness},
 urldate = {2022-09-05},
 volume = {28},
 year = {2022}
}

