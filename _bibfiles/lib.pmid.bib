 doi = {10.1038/83799},
 file = {/Users/jkb/Zotero/storage/CFSQ8J9E/Lee et al. - 2001 - Identification of a gene, ABCG5, important in the .pdf;/Users/jkb/Zotero/storage/7IXMWKAW/ng0101_79.html},
 issn = {1061-4036},
 journal = {Nature Genetics},
 langid = {english},
 month = {January},
 number = {1},
 pages = {79--83},
 title = {Identification of a Gene, {{ABCG5}}, Important in the Regulation of Dietary Cholesterol Absorption},
 urldate = {2015-03-14},
 volume = {27},
