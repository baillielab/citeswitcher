 issn = {1552-4469},
 journal = {Nature Chemical Biology},
 langid = {english},
 month = {January},
 number = {1},
 pages = {88--94},
 title = {N6-{{Methyladenosine}} Methyltransferase {{ZCCHC4}} Mediates Ribosomal {{RNA}} Methylation},
 urldate = {2021-08-04},
