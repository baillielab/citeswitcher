}

@article{liulipopolysaccharideinducesanandamide2003,
 abstract = {Macrophage-derived endocannabinoids have been implicated in endotoxin (lipopolysaccharide (LPS))-induced hypotension, but the endocannabinoid involved and the mechanism of its regulation by LPS are unknown. In RAW264.7 mouse macrophages, LPS (10 ng/ml) increases anandamide (AEA) levels {$>$}10-fold via CD14-, NF-\{kappa\}B-, and p44/42-dependent, platelet-activating factor-independent activation of the AEA biosynthetic enzymes, N-acyltransferase and phospholipase D. LPS also induces the AEA-degrading enzyme fatty acid amidohydrolase (FAAH), and inhibition of FAAH activity potentiates, whereas actinomycin D or cycloheximide blocks the LPS-induced increase in AEA levels and N-acyltransferase and phospholipase D activities. In contrast, cellular levels of the endocannabinoid 2-arachidonoylglycerol (2-AG) are unaffected by LPS but increased by platelet-activating factor. LPS similarly induces AEA, but not 2-AG, in mouse peritoneal macrophages where basal AEA levels are higher, and the LPS-stimulated increase in AEA is potentiated in cells from FAAH-/- as compared with FAAH+/+ mice. Intravenous administration of 107 LPS-treated mouse macrophages to anesthetized rats elicits hypotension, which is much greater in response to FAAH-/- than FAAH+/+ cells and is susceptible to inhibition by SR141716, a cannabinoid CB1 receptor antagonist. We conclude that AEA and 2-AG synthesis are differentially regulated in macrophages, and AEA rather than 2-AG is a major contributor to LPS-induced hypotension.},
 author = {Liu, Jie and Batkai, Sandor and Pacher, Pal and {Harvey-White}, Judith and Wagner, Jens A. and Cravatt, Benjamin F. and Gao, Bin and Kunos, George},
 doi = {10.1074/jbc.M306062200},
 file = {/Users/jkb/Zotero/storage/XQHMVZGV/Liu et al - 2003 - Lipopolysaccharide Induces Anandamide Synthesis in.pdf;/Users/jkb/Zotero/storage/QWTPK6JV/45034.html},
 journal = {J. Biol. Chem.},
 month = {November},
 number = {45},
 pages = {45034--45039},
 title = {Lipopolysaccharide {{Induces Anandamide Synthesis}} in {{Macrophages}} via {{CD14}}/{{MAPK}}/{{Phosphoinositide}} 3-{{Kinase}}/{{NF-}}\{kappa\}{{B Independently}} of {{Platelet-activating Factor}}},
 urldate = {2009-05-17},
 volume = {278},
 year = {2003}
}

@article{liumetaanalysisimputationrefines2010,
 abstract = {Smoking is a leading global cause of disease and mortality. We established the Oxford-GlaxoSmithKline study (Ox-GSK) to perform a genome-wide meta-analysis of SNP association with smoking-related behavioral traits. Our final data set included 41,150 individuals drawn from 20 disease, population and control cohorts. Our analysis confirmed an effect on smoking quantity at a locus on 15q25 (P = 9.45 x 10(-19)) that includes CHRNA5, CHRNA3 and CHRNB4, three genes encoding neuronal nicotinic acetylcholine receptor subunits. We used data from the 1000 Genomes project to investigate the region using imputation, which allowed for analysis of virtually all common SNPs in the region and offered a fivefold increase in marker density over HapMap2 (ref. 2) as an imputation reference panel. Our fine-mapping approach identified a SNP showing the highest significance, rs55853698, located within the promoter region of CHRNA5. Conditional analysis also identified a secondary locus (rs6495308) in CHRNA3.},
 author = {Liu, Jason Z and Tozzi, Federica and Waterworth, Dawn M and Pillai, Sreekumar G and Muglia, Pierandrea and Middleton, Lefkos and Berrettini, Wade and Knouff, Christopher W and Yuan, Xin and Waeber, G{\'e}rard and Vollenweider, Peter and Preisig, Martin and Wareham, Nicholas J and Zhao, Jing Hua and Loos, Ruth J F and Barroso, In{\^e}s and Khaw, Kay-Tee and Grundy, Scott and Barter, Philip and Mahley, Robert and Kesaniemi, Antero and McPherson, Ruth and Vincent, John B and Strauss, John and Kennedy, James L and Farmer, Anne and McGuffin, Peter and Day, Richard and Matthews, Keith and Bakke, Per and Gulsvik, Amund and Lucae, Susanne and Ising, Marcus and Brueckl, Tanja and Horstmann, Sonja and Wichmann, H-Erich and Rawal, Rajesh and Dahmen, Norbert and Lamina, Claudia and Polasek, Ozren and Zgaga, Lina and Huffman, Jennifer and Campbell, Susan and Kooner, Jaspal and Chambers, John C and Burnett, Mary Susan and Devaney, Joseph M and Pichard, Augusto D and Kent, Kenneth M and Satler, Lowell and Lindsay, Joseph M and Waksman, Ron and Epstein, Stephen and Wilson, James F and Wild, Sarah H and Campbell, Harry and Vitart, Veronique and Reilly, Muredach P and Li, Mingyao and Qu, Liming and Wilensky, Robert and Matthai, William and Hakonarson, Hakon H and Rader, Daniel J and Franke, Andre and Wittig, Michael and Sch{\"a}fer, Arne and Uda, Manuela and Terracciano, Antonio and Xiao, Xiangjun and Busonero, Fabio and Scheet, Paul and Schlessinger, David and St Clair, David and Rujescu, Dan and Abecasis, Gon{\c c}alo R and Grabe, Hans J{\"o}rgen and Teumer, Alexander and V{\"o}lzke, Henry and Petersmann, Astrid and John, Ulrich and Rudan, Igor and Hayward, Caroline and Wright, Alan F and Kolcic, Ivana and Wright, Benjamin J and Thompson, John R and Balmforth, Anthony J and Hall, Alistair S and Samani, Nilesh J and Anderson, Carl A and Ahmad, Tariq and Mathew, Christopher G and Parkes, Miles and Satsangi, Jack and Caulfield, Mark and Munroe, Patricia B and Farrall, Marti