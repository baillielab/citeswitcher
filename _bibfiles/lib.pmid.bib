 number = {9749},
 pages = {1339--1346},
 title = {Critical Care and the Global Burden of Critical Illness in Adults},
 urldate = {2011-06-10},
 volume = {376},
 year = {2010}
}

@article{adisasmitoeffectivenessantiviraltreatment2010,
 abstract = {BACKGROUND: Influenza A(H5N1) continues to cause infections and possesses pandemic potential. METHODS: Data sources were primarily clinical records, published case series, and governmental agency reports. Cox proportional hazards regression was used to estimate the effect of treatment on survival, with adjustment using propensity scores (a composite measure of baseline variables predicting use of treatment). RESULTS: In total, 308 cases were identified from 12 countries: 41 from Azerbaijan, Hong Kong SAR, Nigeria, Pakistan, and Turkey (from clinical records); 175 from Egypt and Indonesia (from various sources); and 92 from Bangladesh, Cambodia, China, Thailand, and Vietnam (from various publications). Overall crude survival was 43.5\%; 60\% of patients who received {$\geq$}1 dose of oseltamivir alone (OS(+)) survived versus 24\% of patients who had no evidence of anti-influenza antiviral treatment (OS(-)) (P {$<$}.001). Survival rates of OS(+) groups were significantly higher than those of OS(-) groups; benefit persisted with oseltamivir treatment initiation},
 author = {Adisasmito, Wiku and Chan, Paul K S and Lee, Nelson and Oner, Ahmet Faik and Gasimov, Viktor and Aghayev, Faik and Zaman, Mukhtiar and Bamgboye, Ebun and Dogan, Nazim and Coker, Richard and Starzyk, Kathryn and Dreyer, Nancy A and Toovey, Stephen},
