 issn = {0009-7330, 1524-4571},
 journal = {Circulation Research},
 keyword = {catheter-tip,collapsible tubes,coughing,deep breathing,electromagnetic velocity transducer,exercise,M{\"u}ller maneuver,Valsalva maneuver},
 langid = {english},
 month = {September},
 number = {3},
