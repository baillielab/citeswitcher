 doi = {10.1056/NEJMra1208623},
 file = {/Users/jkb/Zotero/storage/FV4PVBE5/Angus and van der Poll - 2013 - Severe Sepsis and Septic Shock.pdf;/Users/jkb/Zotero/storage/6EIICDDD/Angus and van der Poll - 2013 - Severe Sepsis and Septic Shock.html},
