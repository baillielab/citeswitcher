@article{wardhostmodulatorsh1n12012,
 abstract = {Influenza A virus infects 5--20\% of the population annually, resulting in {$\sim$}35,000 deaths and significant morbidity. Current treatments include vaccines and drugs that target viral proteins. However, both of these approaches have limitations, as vaccines require yearly development and the rapid evolution of viral proteins gives rise to drug resistance. In consequence additional intervention strategies, that target host factors required for the viral life cycle, are under investigation. Here we employed arrayed whole-genome siRNA screening strategies to identify cell-autonomous molecular components that are subverted to support H1N1 influenza A virus infection of human bronchial epithelial cells. Integration across relevant public data sets exposed druggable gene products required for epithelial cell infection or required for viral proteins to deflect host cell suicide checkpoint activation. Pharmacological inhibition of representative targets, RGGT and CHEK1, resulted in significant protection against infection of human epithelial cells by the A/WS/33 virus. In addition, chemical inhibition of RGGT partially protected against H5N1 and the 2009 H1N1 pandemic strain. The observations reported here thus contribute to an expanding body of studies directed at decoding vulnerabilities in the command and control networks specified by influenza virulence factors.},
 author = {Ward, Samuel E. and Kim, Hyun Seok and Komurov, Kakajan and Mendiratta, Saurabh and Tsai, Pei-Ling and Schmolke, Mirco and Satterly, Neal and Manicassamy, Balaji and Forst, Christian V. and Roth, Michael G. and {Garc{\'i}a-Sastre}, Adolfo and Blazewska, Katarzyna M. and McKenna, Charles E. and Fontoura, Beatriz M. and White, Michael A.},
 doi = {10.1371/journal.pone.0039284},
 file = {/Users/jkb/Zotero/storage/22QKR34J/Ward et al. - 2012 - Host Modulators of H1N1 Cytopathogenicity.pdf;/Users/jkb/Zotero/storage/8WZEIMQF/Ward et al. - 2012 - Host Modulators of H1N1 Cytopathogenicity.pdf;/Users/jkb/Zotero/storage/3UAAKBMG/infodoi10.1371journal.pone.html;/Users/jkb/Zotero/storage/G3WHESVX/infodoi10.1371journal.pone.html},
 journal = {PLoS ONE},
 month = {August},
