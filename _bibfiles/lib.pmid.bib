 month = {November},
 pmcid = {PMC4630784},
 pmid = {26524966},
 shorttitle = {The Role of Host Genetic Factors in Respiratory Tract Infectious Diseases},
 title = {The Role of Host Genetic Factors in Respiratory Tract Infectious Diseases: Systematic Review, Meta-Analyses and Field Synopsis},
 urldate = {2019-02-12},
