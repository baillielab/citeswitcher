@article{butlerlaporte2022,
 abstract = {Host genetics is a key determinant of COVID-19 outcomes. Previously, the COVID-19 Host Genetics Initiative genome-wide association study used common variants to identify multiple loci associated with COVID-19 outcomes. However, variants with the largest impact on COVID-19 outcomes are expected to be rare in the population. Hence, studying rare variants may provide additional insights into disease susceptibility and pathogenesis, thereby informing therapeutics development. Here, we combined whole-exome and whole-genome sequencing from 21 cohorts across 12 countries and performed rare variant exome-wide burden analyses for COVID-19 outcomes. In an analysis of 5,085 severe disease cases and 571,737 controls, we observed that carrying a rare deleterious variant in the SARS-CoV-2 sensor toll-like receptor TLR7 (on chromosome X) was associated with a 5.3-fold increase in severe disease (95% CI: 2.75–10.05, p = 5.41x10-7). This association was consistent across sexes. These results further support TLR7 as a genetic determinant of severe disease and suggest that larger studies on rare variants influencing COVID-19 outcomes could provide additional insights.},
 author = {Guillaume Butler-Laporte and Gundula Povysil and Jack A. Kosmicki and Elizabeth T. Cirulli and Theodore Drivas and Simone Furini and Chadi Saad and Axel Schmidt and Pawel Olszewski and Urszula Korotko and Mathieu Quinodoz and Elifnaz Çelik and Kousik Kundu and Klaudia Walter and Junghyun Jung and Amy D. Stockwell and Laura G. Sloofman and Daniel M. Jordan and Ryan C. Thompson and Diane Del Valle and Nicole Simons and Esther Cheng and Robert Sebra and Eric E. Schadt and Seunghee Kim-Schulze and Sacha Gnjatic and Miriam Merad and Joseph D. Buxbaum and Noam D. Beckmann and Alexander W. Charney and Bartlomiej Przychodzen and Timothy Chang and Tess D. Pottinger and Ning Shang and Fabian Brand and Francesca Fava and Francesca Mari and Karolina Chwialkowska and Magdalena Niemira and Szymon Pula and J. Kenneth Baillie and Alex Stuckey and Antonio Salas and Xabier Bello and Jacobo Pardo-Seco and Alberto Gómez-Carballa and Irene Rivero-Calle and Federico Martinón-Torres and Andrea Ganna and Konrad J. Karczewski and Kumar Veerapen and Mathieu Bourgey and Guillaume Bourque and Robert J.M. Eveleigh and Vincenzo Forgetta and David Morrison and David Langlais and Mark Lathrop and Vincent Mooser and Tomoko Nakanishi and Robert Frithiof and Michael Hultström and Miklos Lipcsey and Yanara Marincevic-Zuniga and Jessica Nordlund and Kelly M. Schiabor Barrett and William Lee and Alexandre Bolze and Simon White and Stephen Riffle and Francisco Tanudjaja and Efren Sandoval and Iva Neveux and Shaun Dabe and Nicolas Casadei and Susanne Motameny and Manal Alaamery and Salam Massadeh and Nora Aljawini and Mansour S. Almutairi and Yaseen M. Arabi and Saleh A. Alqahtani and Fawz S. Al Harthi and Amal Almutairi and Fatima Alqubaishi and Sarah Alotaibi and Albandari Binowayn and Ebtehal A. Alsolm and Hadeel El Bardisy and Mohammad Fawzy and Fang Cai and Nicole Soranzo and Adam Butterworth and Regeneron Genetics Center and Daniel H. Geschwind and Stephanie Arteaga and Alexis Stephens an