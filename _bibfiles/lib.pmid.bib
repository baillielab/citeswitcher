 volume = {5},
 year = {2018}
}

@article{komurohumanalveolarmacrophages2001,
 abstract = {{$<$}p{$>$}Human alveolar macrophages (A-M{$\Phi$}) and macrophages (M{$\Phi$}) generated from human monocytes under the influence of granulocyte-macrophage colony-stimulating factors (GM-M{$\Phi$}) express high levels of catalase activity and are highly resistant to H\textsubscript{2}O\textsubscript{2}. In contrast, M{$\Phi$} generated from monocytes by macrophage colony-stimulating factors (M-M{$\Phi$}) express low catalase activity and are about 50-fold more sensitive to H\textsubscript{2}O\textsubscript{2} than GM-M{$\Phi$} or A-M{$\Phi$}. Both A-M{$\Phi$} and GM-M{$\Phi$} but not M-M{$\Phi$} can induce catalase expression in both protein and mRNA levels when stimulated with H\textsubscript{2}O\textsubscript{2} or zymosan. M-M{$\Phi$} but not GM-M{$\Phi$} produce a large amount of H\textsubscript{2}O\textsubscript{2} in response to zymosan or heat-killed \emph{Staphylococcus aureus}. These findings indicate that GM-M{$\Phi$} and A-M{$\Phi$} but not M-M{$\Phi$} are strong scavengers of H\textsubscript{2}O\textsubscript{2} via the high basal level of catalase activity and a marked ability of catalase induction and that catalase activity of M{$\Phi$} is regulated by colony-stimulating factors during differentiation.{$<$}/p{$>$}},
