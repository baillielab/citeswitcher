 issn = {0027-8424, 1091-6490},
 journal = {Proceedings of the National Academy of Sciences},
 keyword = {genome-wide association study,high-altitude adaptation,mixed linear model,polygenic selection,Tibetans},
 langid = {english},
 month = {March},
 pages = {201617042},
 pmid = {28373541},
 title = {Genetic Signatures of High-Altitude Adaptation in {{Tibetans}}},
 urldate = {2019-02-01},
