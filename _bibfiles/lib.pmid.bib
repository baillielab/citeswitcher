 doi = {10.1126/science.1143767},
 file = {/Users/jkb/Zotero/storage/PUQ2575C/Fellay et al. - 2007 - A Whole-Genome Association Study of Major Determin.pdf;/Users/jkb/Zotero/storage/NZWWMXIG/944.html},
 journal = {Science},
