 month = {January},
 number = {1 Suppl},
 pages = {S30-7},
 pmid = {19104223},
 shorttitle = {Animal Models of Sepsis},
 title = {Animal Models of Sepsis: Why Does Preclinical Efficacy Fail to Translate to the Clinical Setting?},
 urldate = {2009-02-18},
 volume = {37},
