 file = {/Users/jkb/Zotero/storage/2NFJXF67/Wright et al. - 2014 - Heritability and genomics of gene expression in pe.pdf;/Users/jkb/Zotero/storage/8GNKIZS9/Wright et al. - 2014 - Heritability and genomics of gene expression in pe.pdf;/Users/jkb/Zotero/storage/2QAN997Z/Wright et al. - 2014 - Heritability and genomics of gene expression in pe.html;/Users/jkb/Zotero/storage/GPCMERAF/Wright et al. - 2014 - Heritability and genomics of gene expression in pe.html},
