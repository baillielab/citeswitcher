 issn = {2405-4712},
 journal = {Cell Systems},
 keyword = {enzyme abundance,genotype-phenotype problem,hierarchical regulation,high-throughput proteomics,machine learning,metabolic control analysis,metabolism,multi-omics},
 month = {September},
