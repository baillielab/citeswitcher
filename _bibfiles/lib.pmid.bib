 doi = {10/f8tgs6},
 file = {/Users/jkb/Zotero/storage/DB9EH4Q4/Hewitt et al. - 2016 - Cohort profile of the UK Biobank diagnosis and ch.pdf;/Users/jkb/Zotero/storage/TWM8DP8W/e009161.html},
