 title = {Efficacy of Combination Therapy with Amantadine, Thymosin {$A$}1 and {$\alpha$}/{$\beta$} Interferon in Mice Infected with Influenza a Virus},
 urldate = {2013-07-14},
 volume = {18},
 year = {1996}
