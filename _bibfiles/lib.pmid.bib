 issn = {0006-291X},
 journal = {Biochemical and Biophysical Research Communications},
 keyword = {gene expression,Gene expression,metabolic syndrome,Mutagenesis,PGC-1{$\alpha$},PPAR{$\gamma$}2,SNP},
 month = {February},
