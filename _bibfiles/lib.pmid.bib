 copyright = {{\copyright} 2020, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution 4.0 International), CC BY 4.0, as described at http://creativecommons.org/licenses/by/4.0/},
 doi = {10.1101/2020.11.18.388306},
 file = {/Users/jkb/Zotero/storage/Z7RKSHTW/Ulferts et al. - 2020 - Subtractive CRISPR screen identifies factors invol.pdf;/Users/jkb/Zotero/storage/PBMJF3CB/2020.11.18.html},
 journal = {bioRxiv},
 langid = {english},
 month = {November},
 pages = {2020.11.18.388306},
