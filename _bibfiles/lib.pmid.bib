@article{quachgeneticadaptationneandertal2016,
 abstract = {Summary Humans differ in the outcome that follows exposure~to life-threatening pathogens, yet the extent of population differences in immune responses and their genetic and evolutionary determinants remain undefined. Here, we characterized, using RNA sequencing, the transcriptional response of primary monocytes from Africans and Europeans to bacterial and viral stimuli---ligands activating Toll-like receptor pathways (TLR1/2, TLR4, and TLR7/8) and influenza virus---and mapped expression quantitative trait loci (eQTLs). We identify numerous cis-eQTLs that contribute to the marked differences in immune responses detected within and between populations and a strong trans-eQTL hotspot at TLR1 that decreases expression of pro-inflammatory genes in Europeans only. We find that immune-responsive regulatory variants are enriched in population-specific signals of natural selection and show that admixture with Neandertals introduced regulatory variants into European genomes, affecting preferentially responses to viral challenges. Together, our study uncovers evolutionarily important determinants of differences in host immune responsiveness between human populations.},
 author = {Quach, H{\'e}l{\`e}ne and Rotival, Maxime and Pothlichet, Julien and Loh, Yong-Hwee~Eddie and Dannemann, Michael and Zidane, Nora and Laval, Guillaume and Patin, Etienne and Harmant, Christine and Lopez, Marie and Deschamps, Matthieu and Naffakh, Nadia and Duffy, Darragh and Coen, Anja and {Leroux-Roels}, Geert and Cl{\'e}ment, Frederic and Boland, Anne and Deleuze, Jean-Fran{\c c}ois and Kelso, Janet and Albert, Matthew~L. and {Quintana-Murci}, Lluis},
 doi = {10.1016/j.cell.2016.09.024},
 file = {/Users/jkb/Zotero/storage/NSZWKJUR/Quach et al. - 2016 - Genetic Adaptation and Neandertal Admixture Shaped.pdf;/Users/jkb/Zotero/storage/MCE9EQ6X/S009286741631306X.html},
