@article{strangerprogresspromisegenomewide2011,
 abstract = {Enormous progress in mapping complex traits in humans has been made in the last 5 yr. There has been early success for prevalent diseases with complex phenotypes. These studies have demonstrated clearly that, while complex traits differ in their underlying genetic architectures, for many common disorders the predominant pattern is that of many loci, individually with small effects on phenotype. For some traits, loci of large effect have been identified. For almost all complex traits studied in humans, the sum of the identified genetic effects comprises only a portion, generally less than half, of the estimated trait heritability. A variety of hypotheses have been proposed to explain why this might be the case, including untested rare variants, and gene--gene and gene--environment interaction. Effort is currently being directed toward implementation of novel analytic approaches and testing rare variants for association with complex traits using imputed variants from the publicly available 1000 Genomes Project resequencing data and from direct resequencing of clinical samples. Through integration with annotations and functional genomic data as well as by in vitro and in vivo experimentation, mapping studies continue to characterize functional variants associated with complex traits and address fundamental issues such as epistasis and pleiotropy. This review focuses primarily on the ways in which genome-wide association studies (GWASs) have revolutionized the field of human quantitative genetics.},
 author = {Stranger, Barbara E. and Stahl, Eli A. and Raj, Towfique},
 doi = {10.1534/genetics.110.120907},
 file = {/Users/jkb/Zotero/storage/FGF5C7QV/Stranger et al_2011_Progress and Promise of Genome-Wide Association Studies for Human Complex Trait.pdf;/Users/jkb/Zotero/storage/KHT7MG4A/Stranger et al. - 2011 - Progress and Promise of Genome-Wide Association St.pdf;/Users/jkb/Zotero/storage/7JTENEDT/367.html;/Users/jkb/Zotero/storage/VFKQ6TRF/Stranger et al. - 2011 - Progress and Promise of Genome-Wide Association St.html},
 issn = {0016-6731, 1943-2631},
 journal = {Genetics},
 langid = {english},
 month = {January},
 number = {2},
 pages = {367--383},
 title = {Progress and {{Promise}} of {{Genome-Wide Association Studies}} for {{Human Complex Trait Genetics}}},
 urldate = {2012-09-13},
 volume = {187},
 year = {2011}
}

