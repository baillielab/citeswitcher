@article{thijscoagulationdisordersseptic1993,
 abstract = {Abnormalities in coagulation and fibrinolysis are frequently observed in septic shock. The most pronounced clinical manifestation is disseminated intravascular coagulation. Recent studies in human volunteers and animal models have clarified the early dynamics and route of activation of both coagulation and fibrinolytic pathways. In healthy subjects subjected to a low dose of either endotoxin or TNF an imbalance in the procoagulant and the fibrinolytic mechanisms is apparent, resulting in a procoagulant state. Also in patients with septic shock a dynamic process of coagulation and fibrinolysis is ongoing with evidence of impaired fibrinolysis. These abnormalities have prognostic significance; the extent of disturbances of coagulation and fibrinolysis is related to the development of multiple organ failure and death},
 author = {Thijs, L.G. and {de Boer}, J.P. and {de Groot}, M.C. and Hack, C.E.},
 journal = {Intensive Care Med},
 keyword = {{Disease Models,Animal},{Shock,Septic},abnormalities,Animal,blood,Blood Coagulation,Blood Coagulation Disorders,Blood Coagulation Factors,complications,Death,Disseminated Intravascular Coagulation,etiology,Fibrinolysis,Human,mortality,Multiple Organ Failure,Netherlands,physiology,physiopathology,Prognosis,Shock,Survival Rate},
 pages = {S8-15},
 title = {Coagulation Disorders in Septic Shock},
 volume = {19 Suppl 1},
 year = {1993}
