 pages = {1215--1223},
 pmcid = {PMC1988871},
 pmid = {17717141},
 title = {Human and {{Avian Influenza Viruses Target Different Cells}} in the {{Lower Respiratory Tract}} of {{Humans}} and {{Other Mammals}}},
