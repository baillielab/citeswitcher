 journal = {Nature Genetics},
 keyword = {{Chromosomes, Human, Pair 15},{Genome, Human},{Models, Genetic},{Polymorphism, Single Nucleotide},{Receptors, Nicotinic},Adult,Aged,Alleles,Chromosome Mapping,Cohort Studies,Female,Genetic Markers,Humans,Male,Middle Aged,Neurons,Smoking},
