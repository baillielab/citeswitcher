 keyword = {{Blotting, Western},{Influenza, Human},{Polymorphism, Single Nucleotide},{Promoter Regions, Genetic},Alleles,CCCTC-Binding Factor,CD8-Positive T-Lymphocytes,DNA Methylation,Genetic Predisposition to Disease,Genotype,Humans,Interferon Regulatory Factor-3,Membrane Proteins,Nasal Lavage Fluid,Quantitative Trait Loci,Repressor Proteins,RNA-Binding Proteins,Severity of Illness Index},
 langid = {english},
