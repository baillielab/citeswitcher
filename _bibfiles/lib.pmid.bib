 title = {The Mononuclear Phagocyte System Revisited},
 urldate = {2010-11-09},
 volume = {72},
 year = {2002}
}

@article{humemononuclearphagocytesystem2006,
 abstract = {Institute for Molecular Bioscience, University of Queensland, Q4072, Australia The mononuclear phagocyte system (MPS) has been defined as a family of cells comprising bone marrow progenitors, blood monocytes and tissue macrophages. Macrophages are a major cell population in most of the tissues in the body, and their numbers increase further in inflammation, wounding and malignancy. Their trophic roles for other cell types in development and homeostasis are becoming increasingly evident. The receptor for macrophage colony-stimulating factor (CSF-1R) is expressed in a large proportion of cells considered to be mononuclear phagocytes, including antigen-presenting dendritic cells, which can be considered a specialized adaptive state rather than a separate lineage. The unity of the MPS is challenged by evidence that there is a separate embryonic phagocyte lineage, by the transdifferentiation and fusion of MPS cells with other cell types, and by evidence of local renewal of tissue macrophage populations as opposed to monocyte recruitment. The concept of the MPS may have partly outlived its usefulness. The mononuclear phagocyte system (MPS) has been defined as a hematopoietic cell lineage derived from progenitor cells in the bone marrow. Committed myeloid progenitor cells differentiate to form blood monocytes, circulate in the blood and then enter tissues to become resident tissue macrophages [1]. In the traditional view of the MPS, the majority of cell division occurs in the monoblasts and promonocytes, and the proliferation of mature macrophages makes a small contribution to the maintenance of resident tissue macrophage numbers [1]. Mononuclear phagocytes as they appear in tissues share several features: Surface protein markers defined by monoclonal antibodies provided a significant impetus to the definition of the MPS. Many such molecules are receptors involved in innate or acquired immunity, as reviewed recently by Taylor et al. [2]. One such antibody is F4/80, and BM8 antibody binds a separate epitope on the same antigen [3]. The F4/80 antibody recognizes a member of a family of genes that also includes human epidermal growth factor (EGF) module-containing mucin-like hormone receptor 1 (EMR1) and human CD97 (reviewed in [4]). Members of this EGF-TM7 family are characterized by a variable number of amino-terminal EGF domains and seven transmembrane-spanning hydrophobic regions, resembling the G-protein-coupled peptide hormone receptor family. Mice and humans differ in the number of functional members of the EGF-TM7 family; mice have two and humans have four, so strict orthological relationships are difficult to assess [4]. In humans, EMR1, EMR2 and EMR3 appear to be strongly enriched in monocytes as well as other myeloid cells (see http://symatlas.gnf.org). Initial studies of an EMR1-knockout mouse revealed no clear phenotype [3]. There could be some redundancy due to partial overlapping expression of the other family member, EMR4, in monocytes [5]. Clues as to their function may come from CD97, for which a cellular ligand has been identified (CD55) and from EMR2 in humans, which appears to have binding activity for proteoglycans [4]. Recently, EMR1-knockout mice were shown to have a major deficiency in the generation of regulatory T cells [6{$\bullet$}], implying inter alia that the cells that bear the EMR1 antigen have a role in immunological tolerance (see below). F4/80 antigen is present on the cell surface of a family of cells that includes the majority of well-defined members of the MPS in the mouse. A unique advantage of the F4/80 antibody is that it binds to an epitope that is resistant to gluteraldehyde fixation and paraffin embedding, enabling high quality imaging of the remarkable effects of macrophages in tissues, and their localization in precise anatomical niches. A database of images of tissue macrophages in all mouse organs identified by F4/80 can be found online (URL: http://www.macrophages.com). The precise anatomical location of these cells suggests some purpose relating to physiology rather than immunity; a quite distinct view from the concept of the wandering phagocyte. One possible role for tissue macrophages is in the phagocytosis and elimination of dying cells, but in sites where physiological apoptosis occurs it is clear that newly recruited blood monocytes are the primary effectors. A second possible role is implied by the ability of macrophages to secrete an extraordinary diversity of regulators known to influence the physiological functions and differentiation of neighbouring cells [1]. The inferred trophic role of tissue macrophages is supported by studies on macrophage-deficient mice. The clearest evidence of such roles comes from the study of op/op mice, which have a mutation in the gene encoding the key macrophage growth factor, colony-stimulating factor-1 (CSF-1), or more recently an introduced mutation in the CSF-1 receptor (c-fms) locus. Macrophage-deficient op/op mice exhibit male and female infertility, and gross sensory neuron dysfunction, and CSF-1-dependent macrophages are absolutely required for ductal outgrowth in mammary gland development (reviewed in [1 and 7]). Two recent studies demonstrated an obligatory role for CSF-1-dependent macrophages in development of the insulin-secreting cells of the pancreas [8 and 9]. Mice with a knockout of the myeloid-specific transcription factor PU.1 also have a gross deficiency of macrophages, but there has been less investigation of these phenotypic consequences because of early postnatal lethality. A recent elegant study compared the gene expression profiles in skin wounds of neonatal wild-type and PU.1-knockout mice. Neonatal wound healing occurs very rapidly, and is unaffected by macrophage depletion. This study emphasizes the association between macrophage infiltration and fibrosis and, inter alia, identifies a number of genes that are inducible as a consequence of macrophage infiltration, representing candidate macrophage markers [10{$\bullet$}]. Although the F4/80 antigen is widely distributed, there are some major macrophage-like cell populations on which it is difficult to detect. These include macrophages of the lung and lymphoid organs and fetal macrophage populations, such as those mentioned above that provide trophic roles in pancreatic islets [9]. Even in the dermis, where macrophages were recently shown to be the major cell population, F4/80 is not expressed on all cells that express other myeloid markers [11]. So, the full extent of the traditional MPS has probably been under-estimated using available markers. Given the obligate function of CSF-1 in macrophage proliferation, differentiation and survival, the CSF-1 receptor was considered as an alternative marker. We therefore spent several years defining the key elements required for accurate transcriptional regulation of c-fms, the gene encoding the CSF-1 receptor. A 7.2 kb promoter region element of the gene, including a key enhancer in the first intron, was found to direct appropriate expression of an enhanced green fluorescent protein (EGFP transgene) in transgenic mice. In mice with a CSF-1R--EGFP transgene, dubbed MacGreen mice, the transgene product marks the vast majority of cells that are considered to be macrophage-like on the basis of location, morphology and, where it can be assessed, surface marker expression [12]. An extensive collection of these images is also available online (URL: http://www.macrophages.com). This marker also provides the facility for life imaging, for example, of myeloid cells adhering to vessel walls in inflammatory sites. As anticipated, the CSF-1R--EGFP marker gives an even more striking indication of the extent of the mononuclear phagocyte system and highlights, in particular, the population that provides an almost continuous subendothelial lining throughout the microcirculation. Similar to F4/80, the CSF-1R--EGFP transgene is expressed at very high levels in epidermal Langerhans cells, which are only partly affected by the op/op mutation in the CSF-1 gene, although more so by the CSF-1R knockout [13]. Langerhans cells are regarded as immature precursors of antigen-presenting myeloid dendritic cells (DCs). Although their name is based upon a morphology that is shared with activated macrophages, so-called DCs are defined primarily by their ability to activate na{\"i}ve T cells, although they also tend to express a particular set of markers, including the integrin CD11c. The EGFP transgene is also detected uniformly on classical splenic DCs, as defined by expression of CD11c, and on bone-marrow-derived DCs produced by cultivation in granulocyte-macrophage CSF (GM-CSF) [12]. The expression of CSF-1R in DCs implies a role for CSF-1 in their differentiation. Previous reports suggested that DC production was not affected by the CSF-1 mutation, but we recently revisited the role of CSF-1 in DC biology, and showed that DC numbers are, indeed, dependent on CSF-1 [14{$\bullet$}]. The relationship between macrophages and DCs has been a matter of some debate since the original definition of the MPS [1]. More recently, it has become evident that the poorly endocytic, specialized antigen-presenting cell phenotype of the archetypal DC arises following phagocytic activation of a cell that, by most accepted criteria, would be called a macrophage. There are few markers that `distinguish' macrophages from DCs, and much of the distinction between the two cell types is based upon the circular logic inherent in definition by any marker or the assertion that any cell that presents antigen to a na{\"i}ve T cell is a DC. The EGFP marker expression in MacGreen mice suggests that macrophages and myeloid DCs are united by their ability to sustain activity of the CSF-1R promoter. Hence, it remains questionable whether there is any real basis for a clear distinction between DCs and other mononuclear phagocytes, or whether there is a continuum of cellular phenotypes that invites classification at the extremes, but lacks a clear distinguishing boundary. My view is that myeloid DCs are just another mononuclear phagocyte cell population, no more distinct than microglia are from Kupffer cells. Even the supposed distinction based upon antigen-presenting function has been challenged recently by studies showing that purified CD11c-negative macrophages can prime na{\"i}ve T cells in vivo [15{$\bullet$}]. A rather more controversial issue is the relationship between monocytic macrophages and neutrophilic granulocytes, which are commonly viewed as a distinct lineage. We recently found that the transcriptomes of macrophages and granulocytes are overwhelmingly similar, and granulocytes express the CSF-1R--EGFP transgene, CSF-1R and F4/80 (EMR1) mRNA, but yet do not express CSF-1R nor F4/80 proteins (DA Hume et al., unpublished). This is interesting in light of recent findings that mature granulocytes can be induced to adopt macrophage- and DC-like phenotypes in vitro in response to various stimuli [16 and 17{$\bullet$}]. The accepted dogma is that, within inflammatory lesions, granulocytes infiltrate rapidly, die and are removed and/or replaced by a second wave of mononuclear inflammatory cells. Macrophages and granulocytes clearly share committed marrow progenitors, but we must now consider the possibility that they interconvert. If this is found to occur, the `mononuclear phagocyte' definition would become untenable, as the very nomenclature is based upon the contrast between mononuclear phagocytes and polymorphonuclear phagocytes (neutrophils). In the embryo, the first cells to express the CSF-1 receptor (c-fms) mRNA arise in the yolk sac and migrate into the head in advance of the developing circulation. These cells are clearly actively involved in the phagocytosis of dying cells. Yolk-sac-derived phagocytes arise independently of classical haematopoietic islands of the yolk sac, appear to be distinct from classical monocytes (never expressing the s100A8/A9 genes, which are expressed at high levels in liver myeloid precursors), and do not express mature macrophage markers such as F4/80. Additionally, they lack expression of the key macrophage transcriptional regulator PU.1, and their appearance is unaffected by a mutation in this gene that blocks development of myeloid cells in the liver [18]. A very detailed analysis of the appearance of macrophage-like cells in the yolk sac was published recently [19], and it appears that the PU.1-independent phagocytes are maintained through embryonic development. The question is whether they are still retained in the adult, and perhaps constitute a source of tissue macrophages with a capacity for self-renewal. Interestingly, there is very clear genetic evidence in zebrafish for two independent populations of `mononuclear phagocytes'. Consistent with the expression of c-fms in the mouse, the migration of the two populations of mononuclear phagocytes is affected by the panther mutation in the zebrafish fms ortholog [20 and 21]. Ralph van Furth (the advocate of the MPS classification) provided evidence in the 1970s and 1980s, on the basis of thymidine pulse-labelling kinetics, that tissue macrophage populations do not generally self-renew, and that the replenishment of these populations mainly arises from monocyte recruitment. Studies based upon donor contributions to organs, such as the lung in bone marrow chimaeras, however, suggest that local proliferation is significant (see [1]). A recent confirmation of this view demonstrated the existence in the ovary, a tissue with an abundant macrophage population, of a population of proliferating monocyte-like cells that could be maintained for months in cell culture without senescence [22]. The existence of monocyte subsets in humans has been known and studied for many years, in most cases on the basis of CD16 expression (the high-affinity Fc receptor). These CD16+ cells appear to be expanded in many inflammatory diseases, and they exhibit preferential migration across endothelial layers in response to the chemokine fractalkine (CX3CL1; [23 and 24]). Only comparatively recently have monocyte subsets been identified in detail in the mouse, in part through the knock-in of a green fluorescent protein (GFP) reporter into the fractalkine receptor (CX3CR1; [25]). Studies using this marker indicated that cells expressing low levels of CX3CR1 are recruited selectively to inflammatory sites, whereas monocytes exhibiting high levels of CX3CR1 give rise to tissue macrophages through fractalkine-dependent recruitment. As in humans, a subset of monocytes is selectively recruited into inflammatory sites, for example, in Listeria infection [26]. In mice, the Ly6C (GR-1) granulocyte surface antigen provides another marker for monocyte subsets, again connecting granulocyte and monocyte phenotypes. A recent study based upon monocyte repopulation following toxic liposome administration suggests that the two monocyte populations actually represent a maturation series, with the Ly6C (high) cells being less mature [27{$\bullet$}]. Bone-marrow-derived precursors have been implicated in the production of neurons, hepatocytes, renal epithelial cells and numerous other cell types (see [1]). At least in vitro, mature blood monocytes and inflammatory macrophages can apparently transform into vascular elements, including endothelial cells, myofibroblasts and smooth muscle cells [28, 29, 30, 31, 32 and 33]. A recent study suggests that a subset of monocytes expresses the type 2 vascular endothelial growth factor (VEGF) receptor [34]. A striking demonstration of this potential in vivo was a study of lymphangiogenesis in injured cornea, in which all of the vascular elements were apparently of myeloid origin [35{$\bullet$}]. In combination with the evidence for interconversion of monocytes and granulocytes, these findings may force us to revert to the concept of a reticuloendothelial system (RES), which predated the MPS concept [1]. There has been considerable controversy in the literature as to whether monocyte transdifferentiation is a significant mechanism in either normal homeostasis or tissue repair in non-vascular cell types. At least in the case of muscle, liver and Purkinje neurons, and possibly many other epithelial cell populations, monocytes probably contribute to regeneration via cell fusion, rather than transdifferentiation [36{$\bullet$}, 37, 38, 39, 40 and 41], but this is still an avenue for therapeutic transplantation and repair of some genetic diseases. In all likelihood, such fusion events involve the macrophage-fusion receptor (also called protein tyrosine phosphase, non-receptor type substrate 1, SIRP{$\alpha$} or CD172a) [42], although the recently described dendritic cell specific transmembrane protein (DC-STAMP), involved in fusion of both osteoclasts and macrophage giant cells, is also an interesting candidate [43 and 44]. The concept of a cellular system united by cellular origin was an attractive one, and it has unified many aspects of the study of innate immunity. The past few years have seen the concept challenged in several ways. One set of observations suggests a fragmentation of the system into subsets with different defined specialisations and activation states, another suggests that the boundaries between mononuclear phagocytes and other myeloid cells, and even other mesodermal cell types, are blurred if not illusory. Most researchers think they know what they mean when they call a cell a macrophage, yet no single marker defines the cell type. The concept of the MPS has probably outlived its usefulness. In my own view, the concepts of cell lineages will become redundant as we come to a greater understanding of the transcriptional networks and plasticity. Transcription is a probabilistic process. Even within a `pure' macrophage population, each individual macrophage has a unique transcriptional profile, and expression of any one gene does not predict the expression of any other with absolute certainty [1]. So, the number of cell types we can define in the innate immune system is probably an exponential function of the number of markers we choose to employ. Ultimately, the innate immune system is better described as a network of interacting genes, and understanding how it works will require a systems biology approach. Papers of particular interest, published within the period of review, have been highlighted as:},
 author = {Hume, David A},
 doi = {10.1016/j.coi.2005.11.008},
 file = {/Users/jkb/Zotero/storage/NE3C9KM6/science.html},
 journal = {Current Opinion in Immunology},
 month = {February},
 number = {1},
 pages = {49--53},
 title = {The Mononuclear Phagocyte System},
 urldate = {2009-02-10},
 volume = {18},
 year = {2006}
}

