 shorttitle = {Can the Flow of Medicines Be Improved?},
 title = {Can the Flow of Medicines Be Improved? {{Fundamental}} Pharmacokinetic and Pharmacological Principles toward Improving {{Phase II}} Survival},
 urldate = {2018-11-17},
