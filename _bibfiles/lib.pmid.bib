 keyword = {eQTL mapping,Evolution,immune response,Monocytes,natural selection,Neandertal admixture,Population genetics,transcriptional responses},
 month = {October},
 number = {3},
 pages = {643-656.e17},
 title = {Genetic {{Adaptation}} and {{Neandertal Admixture Shaped}} the {{Immune System}} of {{Human Populations}}},
 urldate = {2016-11-10},
 volume = {167},
