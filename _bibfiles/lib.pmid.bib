 keyword = {{Microscopy, Confocal},{Receptor, Interferon alpha-beta},{Receptors, Interferon},{Receptors, Interleukin-10},{Receptors, Interleukin},Cell Line,Confocal,Endocytosis,Endosomes,Flow Cytometry,Fluorescent Dyes,Humans,Interferon,Interferon alpha-beta,Interleukin,Interleukin-10,Membrane Proteins,Microscopy,Mutation,Protein-Tyrosine Kinases,Proteins,Receptor,Receptors,Transfection,Transferrin,TYK2 Kinase,Vesicular Transport Proteins},
