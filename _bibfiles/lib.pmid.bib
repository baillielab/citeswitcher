 pmid = {16517405},
 shorttitle = {{{HIF-1-mediated}} Expression of Pyruvate Dehydrogenase Kinase},
 title = {{{HIF-1-mediated}} Expression of Pyruvate Dehydrogenase Kinase: A Metabolic Switch Required for Cellular Adaptation to Hypoxia},
 urldate = {2009-09-09},
 volume = {3},
