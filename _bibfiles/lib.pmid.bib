 issn = {1553-7374},
 journal = {PLOS Pathogens},
 keyword = {Death rates,Drosophila melanogaster,Emerging infectious diseases,Pathogens,Phylogenetic analysis,Phylogenetics,Viral load,Viral replication},
 langid = {english},
 month = {March},
 number = {3},
 pages = {e1004728},
 title = {The {{Causes}} and {{Consequences}} of {{Changes}} in {{Virulence}} Following {{Pathogen Host Shifts}}},
 urldate = {2022-10-25},
 volume = {11},
 year = {2015}
}

