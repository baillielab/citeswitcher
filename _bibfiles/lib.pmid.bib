 file = {/Users/jkb/Zotero/storage/4FWKTSNS/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.pdf;/Users/jkb/Zotero/storage/6W9BJEVH/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.pdf;/Users/jkb/Zotero/storage/G7FQBPE5/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.pdf;/Users/jkb/Zotero/storage/NBA5CCXM/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.pdf;/Users/jkb/Zotero/storage/B6TJ48GZ/e00070-14.html;/Users/jkb/Zotero/storage/CBXK24TJ/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.html;/Users/jkb/Zotero/storage/DAXPN3X8/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.html;/Users/jkb/Zotero/storage/QG675NXN/Dubois et al. - 2014 - Influenza Viruses and mRNA Splicing Doing More wi.html},
 issn = {, 2150-7511},
 journal = {mBio},
 langid = {english},
 month = {January},
 number = {3},
 pages = {e00070-14},
 pmid = {24825008},
 shorttitle = {Influenza {{Viruses}} and {{mRNA Splicing}}},
 title = {Influenza {{Viruses}} and {{mRNA Splicing}}: {{Doing More}} with {{Less}}},
