@article{vincentdrotrecoginalfanew2002,
 abstract = {Severe sepsis is a common and frequently fatal condition. Evidence showing a link between the coagulation system and the inflammatory response to sepsis led to the development of drotrecogin alfa (activated) as an agent in the treatment of sepsis. This recombinant form of the natural protein, activated protein C (Xigris, Eli Lilly Co.), has been shown to significantly reduce mortality in a large randomised, controlled Phase III study involving 1690 patients. The exact mode of action of drotrecogin alfa (activated) remains uncertain, although it clearly combines anticoagulant and anti-inflammatory properties. Although associated with an increased risk of bleeding, this is usually procedure-related rather than spontaneous. Although costly, this is a drug that effectively reduces mortality rates in patients with severe sepsis},
 author = {Vincent, J.L.},
 journal = {Expert.Opin.Biol Ther.},
 keyword = {{Anti-Inflammatory Agents,Non-Steroidal},Anti-Infective Agents,Anti-Inflammatory Agents,Anticoagulants,Belgium,chemistry,Clinical Trials,drug therapy,mortality,Protein C,Recombinant Proteins,Risk,Sepsis,therapeutic use},
