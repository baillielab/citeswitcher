 keyword = {{Aged,80 and over},{Chromosomes,Human,Pair 2},{Polymorphism,Genetic},{Respiration,Artificial},{Respiratory Distress Syndrome,Adult},{Shock,Septic},analysis,Aorta,blood,Case-Control Studies,Cause of Death,Community-Acquired Infections,complications,Critical Care,Dna,epidemiology,etiology,Gene Frequency,Genetic Predisposition to Disease,genetics,Genotype,Hospital Mortality,Lung,mortality,physiology,Pneumonia,Polymerase Chain Reaction,Pulmonary Surfactant-Associated Protein B,Research,Respiratory Insufficiency,Restriction Mapping,Risk,Risk Factors,Shock,statistics \& numerical data,Syndrome,Tennessee,therapy},
 month = {May},
