 issn = {1569-9293, 1569-9285},
 journal = {Interactive CardioVascular and Thoracic Surgery},
 keyword = {{Cardiopulmonary bypass, Oxygenator, Oxygen transfer},Cardiac surgery},
 langid = {english},
