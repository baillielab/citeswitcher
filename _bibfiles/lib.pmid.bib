 doi = {10.1177/14782715221120137},
 file = {/Users/jkb/Zotero/storage/I2UY9VZI/Mutch et al. - 2022 - Performance status A key factor in predicting mor.pdf},
 issn = {2042-8189},
 journal = {The Journal of the Royal College of Physicians of Edinburgh},
 keyword = {Aged,clinical scores,COVID-19,Female,frailty,Hospital Mortality,Hospitalization,Humans,Intensive Care Units,Male,mortality,Retrospective Studies,Risk Factors,SARS-CoV-2,SARS-CoV2},
 langid = {english},
