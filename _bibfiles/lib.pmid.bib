 file = {/Users/jkb/Zotero/storage/TJ77CQFP/Kathiresan et al. - 2008 - Six new loci associated with blood low-density lip.pdf},
 issn = {1546-1718},
 journal = {Nature Genetics},
 keyword = {{Cholesterol, HDL},{Cholesterol, LDL},{Chromosomes, Human, Pair 1},{Chromosomes, Human, Pair 19},{Chromosomes, Human, Pair 7},{Chromosomes, Human, Pair 8},{Genome, Human},{Polymorphism, Single Nucleotide},{RNA, Messenger},{Sequence Analysis, DNA},Aged,Alleles,Case-Control Studies,Cohort Studies,Female,Gene Frequency,Genetic Markers,Genetic Variation,Humans,Linkage Disequilibrium,Liver,Male,Middle Aged,Probability,Prospective Studies,Randomized Controlled Trials as Topic,Triglycerides},
