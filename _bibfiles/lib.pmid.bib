 publisher = {American Chemical Society},
 shorttitle = {Molecular {{Insights}} into {{DC-SIGN Binding}} to {{Self-Antigens}}},
 title = {Molecular {{Insights}} into {{DC-SIGN Binding}} to {{Self-Antigens}}: {{The Interaction}} with the {{Blood Group A}}/{{B Antigens}}},
