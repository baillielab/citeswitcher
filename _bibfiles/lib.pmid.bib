@article{varblevivornaiscreening2013,
 abstract = {RNA interference (RNAi) has been extensively used to identify host factors affecting virus infection but requires exogenous delivery of short interfering RNAs (siRNAs), thus limiting the technique to nonphysiological infection models and a single defined cell type. We report an alternative screening approach using siRNA delivery via infection with a replication-competent RNA virus. In this system, natural selection, defined by siRNA production, permits the identification of host restriction factors through virus enrichment during a physiological infection. We validate this approach with a large-scale siRNA screen in the context of an in~vivo alphavirus infection. Monitoring virus evolution across four independent screens identified two categories of enriched siRNAs: specific effectors of the direct antiviral arsenal and host factors that indirectly dampened the overall antiviral response. These results suggest that pathogenicity may be defined by the ability of the virus to antagonize broad cellular responses and specific antiviral factors.},
 author = {Varble, Andrew and Benitez, Asiel A. and Schmid, Sonja and Sachs, David and Shim, Jaehee V. and {Rodriguez-Barrueco}, Ruth and Panis, Maryline and Crumiller, Marshall and Silva, Jose M. and Sachidanandam, Ravi and {tenOever}, Benjamin R.},
 doi = {10.1016/j.chom.2013.08.007},
 file = {/Users/jkb/Zotero/storage/786U5M43/Varble et al. - 2013 - An In Vivo RNAi Screening Approach to Identify Hos.pdf;/Users/jkb/Zotero/storage/EED22WEJ/Varble et al. - 2013 - An In Vivo RNAi Screening Approach to Identify Hos.html},
 issn = {1931-3128},
 journal = {Cell Host \& Microbe},
 month = {September},
