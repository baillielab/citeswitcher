 issn = {1545-7885},
 journal = {PLoS Biology},
 keyword = {{Aged, 80 and over},{Child, Preschool},{Cholesterol, LDL},{Diabetes Mellitus, Type 1},{Genes, MHC Class II},{Genome, Human},{Polymorphism, Single Nucleotide},{RNA, Messenger},{Transcription, Genetic},Adolescent,Adult,Aged,Animals,Child,Coronary Artery Disease,Female,Gene Expression Profiling,Genetic Predisposition to Disease,Genotype,Humans,Infant,Liver,Male,Mice,Middle Aged,Oligonucleotide Array Sequence Analysis,Quantitative trait loci},
 month = {May},
