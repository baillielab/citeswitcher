 file = {/Users/jkb/Zotero/storage/RYABRZN9/Choobdar et al. - 2018 - Open Community Challenge Reveals Molecular Network.pdf;/Users/jkb/Zotero/storage/8MTYP265/265553v1.html},
 journal = {bioRxiv},
 langid = {english},
 month = {February},
 pages = {265553},
 title = {Open {{Community Challenge Reveals Molecular Network Modules}} with {{Key Roles}} in {{Diseases}}},
 urldate = {2019-08-06},
