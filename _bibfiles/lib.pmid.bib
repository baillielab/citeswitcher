@article{warinnerpathogenshostimmunity2014,
 abstract = {Calcified dental plaque (dental calculus) preserves for millennia and entraps biomolecules from all domains of life and viruses. We report the first, to our knowledge, high-resolution taxonomic and protein functional characterization of the ancient oral microbiome and demonstrate that the oral cavity has long served as a reservoir for bacteria implicated in both local and systemic disease. We characterize (i) the ancient oral microbiome in a diseased state, (ii) 40 opportunistic pathogens, (iii) ancient human--associated putative antibiotic resistance genes, (iv) a genome reconstruction of the periodontal pathogen Tannerella forsythia, (v) 239 bacterial and 43 human proteins, allowing confirmation of a long-term association between host immune factors, 'red complex' pathogens and periodontal disease, and (vi) DNA sequences matching dietary sources. Directly datable and nearly ubiquitous, dental calculus permits the simultaneous investigation of pathogen activity, host immunity and diet, thereby extending direct investigation of common diseases into the human evolutionary past. View full text},
 author = {Warinner, Christina and Rodrigues, Jo{\~a}o F. Matias and Vyas, Rounak and Trachsel, Christian and Shved, Natallia and Grossmann, Jonas and Radini, Anita and Hancock, Y. and Tito, Raul Y. and Fiddyment, Sarah and Speller, Camilla and Hendy, Jessica and Charlton, Sophy and Luder, Hans Ulrich and {Salazar-Garc{\'i}a}, Domingo C. and Eppler, Elisabeth and Seiler, Roger and Hansen, Lars H. and Castruita, Jos{\'e} Alfredo Samaniego and {Barkow-Oesterreicher}, Simon and Teoh, Kai Yik and Kelstrup, Christian D. and Olsen, Jesper V. and Nanni, Paolo and Kawai, Toshihisa and Willerslev, Eske and {von Mering}, Christian and Lewis Jr, Cecil M. and Collins, Matthew J. and Gilbert, M. Thomas P. and R{\"u}hli, Frank and Cappellini, Enrico},
