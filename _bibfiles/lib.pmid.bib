@article{laviehumanl1promoter2004,
 abstract = {Human L1 elements are non-LTR retrotransposons that comprise {$\sim$}17\% of the human genome. Their 5{$\prime$}-untranslated region (5{$\prime$}-UTR) serves as a promoter for L1 transcription. Now we find that transcription initiation sites are not restricted to nucleotide +1 but vary considerably in both downstream and upstream directions. Transcription initiating upstream explains additional nucleotides often seen between the 5{$\prime$}-target site duplication and the L1 start site. A higher frequency of G nucleotides observed upstream from the L1 can be explained by reverse transcription of the L1 RNA 5{$\prime$}-CAP, which is further supported by extra Gs seen for full-length HERV-W pseudogenes. We assayed 5{$\prime$}-UTR promoter activities for several full-length human L1 elements, and found that upstream flanking cellular sequences strongly influence the L1 5{$\prime$}-UTR promoter. These sequences either repress or enhance the L1 promoter activity. Therefore, the evolutionary success of a human L1 in producing progeny depends not only on the L1 itself, but also on its genomic integration site. The promoter mechanism of L1 is reminiscent of initiator (Inr) elements that are TATA-less promoters expressing several cellular genes. We suggest that the L1 5{$\prime$}-UTR is able to form an Inr element that reaches into upstream flanking sequence.},
 author = {Lavie, Laurence and Maldener, Esther and Brouha, Brook and Meese, Eckart U. and Mayer, Jens},
 doi = {10.1101/gr.2745804},
 file = {/Users/jkb/Zotero/storage/8WI6A8MX/Lavie et al. - 2004 - The human L1 promoter Variable transcription init.pdf;/Users/jkb/Zotero/storage/F34XE9UN/Lavie et al. - 2004 - The human L1 promoter Variable transcription init.pdf;/Users/jkb/Zotero/storage/SZK3NE6Q/Lavie et al. - 2004 - The human L1 promoter Variable transcription init.pdf},
 issn = {1088-9051},
 journal = {Genome Research},
 month = {November},
 number = {11},
 pages = {2253--2260},
 pmcid = {PMC525683},
 pmid = {15520289},
 shorttitle = {The Human {{L1}} Promoter},
 title = {The Human {{L1}} Promoter: {{Variable}} Transcription Initiation Sites and a Major Impact of Upstream Flanking Sequence on Promoter Activity},
 urldate = {2016-07-21},
 volume = {14},
 year = {2004}
}

