@article{cooperevolutionadaptiveimmune2006,
 abstract = {A clonally diverse anticipatory repertoire in which each lymphocyte bears a unique antigen receptor is the central feature of the adaptive immune system that evolved in our vertebrate ancestors. The survival advantage gained through adding this type of adaptive immune system to a pre-existing innate immune system led to the evolution of alternative ways for lymphocytes to generate diverse antigen receptors for use in recognizing and repelling pathogen invaders. All jawed vertebrates assemble their antigen-receptor genes through recombinatorial rearrangement of different immunoglobulin or T cell receptor gene segments. The surviving jawless vertebrates, lampreys and hagfish, instead solved the receptor diversification problem by the recombinatorial assembly of leucine-rich-repeat genetic modules to encode variable lymphocyte receptors. The convergent evolution of these remarkably different adaptive immune systems involved innovative genetic modification of innate-immune-system components.},
 author = {Cooper, Max D and Alder, Matthew N},
 doi = {10.1016/j.cell.2006.02.001},
 file = {/Users/jkb/Zotero/storage/MTAJHTJI/16497590.html},
 issn = {0092-8674},
 journal = {Cell},
 keyword = {{Evolution, Molecular},{Models, Biological},{Models, Genetic},Evolution,Gene Rearrangement,Immunity,Immunogenetics,Immunoglobulins,Invertebrates,Lymphocytes,Phylogeny,Vertebrates},
 month = {February},
 number = {4},
 pages = {815--822},
 pmid = {16497590},
 title = {The Evolution of Adaptive Immune Systems},
 urldate = {2009-05-04},
 volume = {124},
 year = {2006}
}

