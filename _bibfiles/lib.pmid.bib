 issn = {2211-1247},
 journal = {Cell Reports},
 keyword = {Capicua,cell-intrinsic immunity,CIC,CRISPR/Cas9 screen,GeCKO,H5N1,host factors,influenza virus,sialic acid pathway,SLC35A1},
 month = {April},
 number = {2},
 pages = {596--607},
 title = {Genome-Wide {{CRISPR}}/{{Cas9 Screen Identifies Host Factors Essential}} for {{Influenza Virus Replication}}},
