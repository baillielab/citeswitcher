@article{mitrysnpmistypinggenotyping2011,
 abstract = {Using genome-wide association studies to identify genetic variants contributing to disease has been highly successful with many novel genetic predispositions identified and biological pathways revealed. Several pitfalls for spurious association or non-replication have been highlighted: from population structure, automated genotype scoring for cases and controls, to age-varying association. We describe an important yet unreported source of bias in case-control studies due to variations in chip technology between different commercial array releases. As cases are commonly genotyped with newer arrays and freely available control resources are frequently used for comparison, there exists an important potential for false associations which are robust to standard quality control and replication design. Genet. Epidemiol. 2011.~~{\copyright} 2011 Wiley-Liss, Inc. 35:423-426, 2011},
 author = {Mitry, D. and Campbell, H. and Charteris, D. G and Fleck, B. W and Tenesa, A. and Dunlop, M. G and Hayward, C. and Wright, A. F and Vitart, V.},
 doi = {10.1002/gepi.20559},
 file = {/Users/jkb/Zotero/storage/GTP5G64C/Mitry et al_2011_SNP mistyping in genotyping arrays—an important cause of spurious association.pdf},
 issn = {1098-2272},
 journal = {Genetic Epidemiology},
 keyword = {false association,genome wide association,genotyping},
 langid = {english},
 month = {July},
 number = {5},
 pages = {423--426},
 title = {{{SNP}} Mistyping in Genotyping Arrays---an Important Cause of Spurious Association in Case-control Studies},
 urldate = {2011-09-17},
 volume = {35},
 year = {2011}
}

@article{miyairihumangeneticfactors2008,
 abstract = {Summary: To explain the wide spectrum of disease severity caused by respiratory syncytial virus (RSV) and because of the limitations of animal models to fully parallel human RSV disease, study of genetic influences on human RSV disease severity has begun. Candidate gene approaches have demonstrated associations of severe RSV in healthy infants with genetic polymorphisms that may alter the innate ability of humans to control RSV (surfactants, Toll-like receptor 4, cell surface adhesion molecules, and others) and those that may control differences in proinflammatory responses or enhanced immunopathology (specific cytokines and their receptors). These studies are reviewed. They are valuable since an understanding of the direction of a polymorphism's effect can help construct a meaningful human RSV disease pathogenesis model. However, the direction, degree, and significance of the statistical association for any given gene are equivocal among studies, and the functional significance of specific polymorphisms is often not even known. Polymorphism frequency distribution differences associated with RSV infection arising from diversity in the genetic background of the population may be confounded further by multiple-hypothesis testing and publication bias, as well as the investigator's perceived importance of a particular pathogenic disease process. Such problems highlight the limitation of the candidate gene approach and the need for an unbiased large-scale genome-wide association study to evaluate this important disease.},
 author = {Miyairi, Isao and DeVincenzo, John P.},
 doi = {10.1128/CMR.00017-08},
 file = {/Users/jkb/Zotero/storage/93VD2TXD/Miyairi and DeVincenzo - 2008 - Human Genetic Factors and Respiratory Syncytial Vi.pdf;/Users/jkb/Zotero/storage/UG55BN72/686.html},
 journal = {Clin. Microbiol. Rev.},
 month = {October},
 number = {4},
 pages = {686--703},
 title = {Human {{Genetic Factors}} and {{Respiratory Syncytial Virus Disease Severity}}},
 urldate = {2009-09-07},
 volume = {21},
 year = {2008}
}

