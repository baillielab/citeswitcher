@article{riewaldactivationendothelialcell2002,
 abstract = {The coagulant and inflammatory exacerbation in sepsis is counterbalanced by the protective protein C (PC) pathway. Activated PC (APC) was shown to use the endothelial cell PC receptor (EPCR) as a coreceptor for cleavage of protease activated receptor 1 (PAR1) on endothelial cells. Gene profiling demonstrated that PAR1 signaling could account for all APC-induced protective genes, including the immunomodulatory monocyte chemoattractant protein-1 (MCP-1), which was selectively induced by activation of PAR1, but not PAR2. Thus, the prototypical thrombin receptor is the target for EPCR-dependent APC signaling, suggesting a role for this receptor cascade in protection from sepsis},
 author = {Riewald, M. and Petrovan, R.J. and Donner, A. and Mueller, B.M. and Ruf, W.},
 journal = {Science},
 keyword = {{Cells,Cultured},{Endothelium,Vascular},{Receptor,PAR-1},{Receptor,PAR-2},{Receptors,Cell Surface},{Receptors,Cytoplasmic and Nuclear},{Receptors,Steroid},{Receptors,Thrombin},agonists,blood,Blood Coagulation,Blood Coagulation Factors,Cells,Chemokine CCL2,cytology,DNA-Binding Proteins,Endothelial Cells,Enzyme Activation,genetics,immunology,metabolism,Mitogen-Activated Protein Kinases,Phosphorylation,Protein C,Research,Sepsis,Signal Transduction,Thrombin},
 month = {June},
